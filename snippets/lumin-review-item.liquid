{%- comment -%}
  Renders a single review block.
  Accepts:
  - block: {Object} review block
  - section: {Object} parent section
  - review_index: {Number} 1-based index among review blocks
  - product: {Object} optional product context
{%- endcomment -%}

{%- liquid
  assign review_image_width = section.settings.rw_img_size | times: 2
  assign customer_image_width = section.settings.customer_image_size | times: 2 | at_most: 120
  assign popup_enabled = section.settings.enable_review_popup
  assign name_parts = block.settings.name_text | split: ' '
  assign initials = ''
  for part in name_parts
    assign initials = initials | append: part | slice: 0, 1
  endfor
  assign initials = initials | slice: 0, 2 | upcase

  assign display_product = product
  if block.settings.selected_product != blank
    assign display_product = block.settings.selected_product
  endif

  assign lr_desk_image_card = false
  if section.settings.review_column_desk > 1 and section.settings.review_desk_image_card
    assign lr_desk_image_card = true
  endif

  if lr_desk_image_card
    assign desk_cols = section.settings.review_column_desk | default: 3 | at_least: 1
    assign tab_cols = section.settings.review_column_tab | default: 2 | at_least: 1
    assign mobile_cols = section.settings.review_column_mobile | default: 1 | at_least: 1
    assign desk_col_pct = 100 | divided_by: desk_cols
    assign tab_col_pct = 100 | divided_by: tab_cols
    assign mobile_col_pct = 100 | divided_by: mobile_cols
    assign review_image_sizes = '(min-width: 901px) ' | append: desk_col_pct | append: 'vw, (min-width: 601px) ' | append: tab_col_pct | append: 'vw, ' | append: mobile_col_pct | append: 'vw'
  endif

  assign review_extra_images = 0
  if block.settings.img_block != blank and block.settings.img_block2 != blank
    assign review_extra_images = 1
  endif

  assign show_footer_border = true
  if section.settings.show_footer_border == false
    assign show_footer_border = false
  endif

  assign lr_block_key = block.id
  unless block.id contains section.id
    assign lr_block_key = section.id | append: '__' | append: block.id
  endunless
  assign lr_block_id_short = block.id
  if block.id contains '__'
    assign lr_block_id_parts = block.id | split: '__'
    assign lr_block_id_short = lr_block_id_parts | last
  endif

  capture lr_gallery_images_json
    echo '['
    assign lr_gallery_json_first = true
    if block.settings.img_block != blank
      assign lr_gallery_alt = block.settings.name_text | append: ' review image'
      if block.settings.img_block.alt != blank
        assign lr_gallery_alt = block.settings.img_block.alt
      endif
      echo '{"type":"primary","url":'
      echo block.settings.img_block | image_url: width: 480 | json
      echo ',"alt":'
      echo lr_gallery_alt | json
      echo '}'
      assign lr_gallery_json_first = false
    endif
    if block.settings.img_block2 != blank
      unless lr_gallery_json_first
        echo ','
      endunless
      assign lr_gallery_alt_2 = block.settings.name_text | append: ' review image 2'
      if block.settings.img_block2.alt != blank
        assign lr_gallery_alt_2 = block.settings.img_block2.alt
      endif
      echo '{"type":"secondary","url":'
      echo block.settings.img_block2 | image_url: width: 480 | json
      echo ',"alt":'
      echo lr_gallery_alt_2 | json
      echo '}'
    endif
    echo ']'
  endcapture
  assign lr_gallery_images_json = lr_gallery_images_json | strip
-%}

<div
  class="rw-container-contant{% unless popup_enabled %} rw-container-contant--no-popup{% endunless %}"
  role="listitem"
  {{ block.shopify_attributes }}
  data-lumin-section-id="{{ section.id }}"
  data-block-id="{{ lr_block_key }}"
  data-block-id-short="{{ lr_block_id_short }}"
  data-review-index="{{ review_index }}"
  style="--lr-review-order: {{ review_index }};"
  {% if block.settings.img_block != blank or block.settings.img_block2 != blank %}
    data-gallery-images='{{ lr_gallery_images_json }}'
  {% endif %}
  data-rating="{{ block.settings.star_rating | default: 5 }}"
  data-like-size="{{ block.settings.like_size }}"
  data-dislike-size="{{ block.settings.dislike_size }}"
  {% if block.settings.customer_image != blank %}
    data-customer-image="{{ block.settings.customer_image | image_url: width: 480 }}"
  {% endif %}
  {% if popup_enabled %}
    tabindex="0"
    role="button"
    aria-label="View review by {{ block.settings.name_text | default: 'customer' }}"
  {% endif %}
>
  <div class="review-wrapper{% if section.settings.show_border %} review-wrapper--bordered{% endif %}{% if lr_desk_image_card %} review-wrapper--image-card{% endif %}">
    <div class="main-review">
      <div class="rw-text">
        <div class="rw-detail">
          <div class="rw-detail-grid">
            <div class="rw-detail-header">
              <div class="customer-info">
                {%- if section.settings.show_customer_images -%}
                  <div class="customer-avatar">
                    {%- if block.settings.customer_image != blank -%}
                      {%- assign avatar_alt = block.settings.name_text | append: ' avatar' -%}
                      {{
                        block.settings.customer_image
                        | image_url: width: customer_image_width
                        | image_tag:
                          alt: avatar_alt,
                          loading: 'lazy',
                          decoding: 'async',
                          widths: '40, 80, 120',
                          sizes: '(max-width: 600px) 40px, 60px',
                          class: 'customer-avatar-img',
                          width: section.settings.customer_image_size,
                          height: section.settings.customer_image_size
                      }}
                      <div class="customer-initials customer-initials--hidden" aria-hidden="true">{{ initials }}</div>
                    {%- else -%}
                      <div class="customer-initials customer-initials--visible">{{ initials }}</div>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                <div class="customer-details">
                  <span class="rw-text-name h2">{{ block.settings.name_text }}</span>

                  {%- if section.settings.show_country_flags and block.settings.show_country_flag and block.settings.country_code != blank -%}
                    {%- liquid
                      assign flag_height = section.settings.date_size | plus: 4
                      if section.settings.flag_style == 'circle'
                        assign flag_width = flag_height
                      else
                        assign flag_width = flag_height | times: 4 | divided_by: 3
                      endif
                    -%}
                    {%- render 'country-flag',
                      country_code: block.settings.country_code,
                      width: flag_width,
                      flag_style: section.settings.flag_style
                    -%}
                  {%- endif -%}
                </div>
              </div>

              <span class="rw-date">{{ block.settings.date_text }}</span>
            </div>

            <span class="zoom-bottom">
              {%- if section.settings.star_style == 'star' -%}
                {% render 'rating-star', block: block, section: section %}
              {%- elsif section.settings.star_style == 'star_bg' -%}
                {% render 'review-star-background', block: block, section: section, rating: block.settings.star_rating %}
              {%- elsif section.settings.star_style == 'star_bg_2' -%}
                {% render 'review-star-crisp', block: block, section: section, rating: block.settings.star_rating %}
              {%- endif -%}
            </span>

            {%- if block.settings.show_verified_buyer != false and section.settings.verify_text != blank -%}
              <div class="verify-container">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14" class="svg verify-icon" aria-hidden="true">
                  <path d="M6.506.28a1.49 1.49 0 011.806.051l.107.096.808.793c.137.134.307.226.492.267l.141.021 1.118.081a1.49 1.49 0 011.353 1.214l.019.134.109 1.125c.018.2.095.39.22.545l.08.09.808.792c.474.475.57 1.202.249 1.779l-.075.121-.627.936a1.022 1.022 0 00-.177.532l.004.143.109 1.13a1.492 1.492 0 01-.949 1.54l-.136.045-1.088.3a1.018 1.018 0 00-.494.312l-.073.094-.633.932a1.49 1.49 0 01-1.715.57l-.133-.053-1.029-.468a1.019 1.019 0 00-.554-.082l-.14.028-1.094.317c-.65.18-1.332-.1-1.674-.667l-.068-.126-.486-1.027a1.019 1.019 0 00-.394-.433l-.106-.055-1.029-.468a1.494 1.494 0 01-.858-1.588l.029-.14.283-1.1A1.01 1.01 0 00.693 7.5l-.052-.133-.493-1.019A1.493 1.493 0 01.51 4.576l.113-.089.918-.65c.165-.117.291-.28.363-.467l.037-.115.287-1.097a1.49 1.49 0 011.418-1.121l.144.004 1.124.084c.19.015.38-.025.548-.112l.122-.075.922-.658zm3.756 5.105c.686-.682-.401-1.526-.947-.98l-.334.344-2.872 3.05-.57-.612-.327-.34-.359-.367-.123-.124a.687.687 0 10-.947.985l.45.46 1.078 1.133.798.851 3.29-3.502.796-.83.067-.068z"></path>
                </svg>
                <span class="verify">{{ section.settings.verify_text }}</span>
              </div>
            {%- endif -%}
          </div>

            <div class="rw-detail-main">
            {%- if section.settings.show_review_heading -%}
              <div class="rw-text-head h4">{{ block.settings.review_head }}</div>
            {%- endif -%}
            <div class="rw-text-main">{{ block.settings.review_text }}</div>

            {%- if block.settings.img_block != blank or block.settings.img_block2 != blank -%}
              <div class="review-images{% if lr_desk_image_card %} review-images--card{% endif %}">
                {%- if review_extra_images > 0 -%}
                  <span class="review-images__count" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <rect x="3" y="7" width="14" height="14" rx="2"></rect>
                      <rect x="7" y="3" width="14" height="14" rx="2"></rect>
                    </svg>
                    +{{ review_extra_images }}
                  </span>
                {%- endif -%}
                {%- if block.settings.img_block != blank -%}
                  {%- assign review_img_full_url = block.settings.img_block | image_url: width: 1600 -%}
                  {%- if lr_desk_image_card -%}
                    {{
                      block.settings.img_block
                      | image_url: width: 800
                      | image_tag:
                        alt: block.settings.img_block.alt,
                        loading: 'lazy',
                        decoding: 'async',
                        fetchpriority: 'low',
                        widths: '400, 600, 800',
                        sizes: review_image_sizes,
                        class: 'review-image',
                        width: 800,
                        data-full-src: review_img_full_url
                    }}
                  {%- else -%}
                    {%- liquid
                      assign review_img_height = section.settings.rw_img_size
                      assign review_img_aspect = block.settings.img_block.aspect_ratio | default: 1
                      assign review_img_display_width = review_img_height | times: review_img_aspect | round | at_least: 1
                    -%}
                    {{
                      block.settings.img_block
                      | image_url: width: review_image_width
                      | image_tag:
                        alt: block.settings.img_block.alt,
                        loading: 'lazy',
                        decoding: 'async',
                        fetchpriority: 'low',
                        widths: '90, 180, 360',
                        sizes: '(max-width: 600px) 90px, 180px',
                        class: 'review-image',
                        width: review_img_display_width,
                        height: review_img_height,
                        data-full-src: review_img_full_url
                    }}
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.img_block2 != blank -%}
                  {%- assign review_img2_full_url = block.settings.img_block2 | image_url: width: 1600 -%}
                  {%- if lr_desk_image_card -%}
                    {{
                      block.settings.img_block2
                      | image_url: width: 800
                      | image_tag:
                        alt: block.settings.img_block2.alt,
                        loading: 'lazy',
                        decoding: 'async',
                        fetchpriority: 'low',
                        widths: '400, 600, 800',
                        sizes: review_image_sizes,
                        class: 'review-image',
                        width: 800,
                        data-full-src: review_img2_full_url
                    }}
                  {%- else -%}
                    {%- liquid
                      assign review_img2_height = section.settings.rw_img_size
                      assign review_img2_aspect = block.settings.img_block2.aspect_ratio | default: 1
                      assign review_img2_display_width = review_img2_height | times: review_img2_aspect | round | at_least: 1
                    -%}
                    {{
                      block.settings.img_block2
                      | image_url: width: review_image_width
                      | image_tag:
                        alt: block.settings.img_block2.alt,
                        loading: 'lazy',
                        decoding: 'async',
                        fetchpriority: 'low',
                        widths: '90, 180, 360',
                        sizes: '(max-width: 600px) 90px, 180px',
                        class: 'review-image',
                        width: review_img2_display_width,
                        height: review_img2_height,
                        data-full-src: review_img2_full_url
                    }}
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.show_footer -%}
              <div
                class="rw-text-footer{% if show_footer_border %} rw-text-footer--bordered{% endif %}"
                {% if show_footer_border %}
                  style="--lr-footer-border-color: {{ section.settings.footer_border_color | default: '#e5e5e5' }};"
                {% endif %}
              >
                {%- if section.settings.show_product and display_product != blank -%}
                  <span class="rw-footer-product">
                    {%- if display_product.featured_image != blank -%}
                      {%- liquid
                        assign product_thumb_width = 30
                        assign product_thumb_src_width = product_thumb_width | times: 4
                      -%}
                      {{
                        display_product.featured_image
                        | image_url: width: product_thumb_src_width
                        | image_tag:
                          alt: display_product.title,
                          loading: 'lazy',
                          decoding: 'async',
                          class: 'review-product-thumb',
                          width: product_thumb_width,
                          widths: '30, 60, 90, 120',
                          sizes: '30px'
                      }}
                    {%- endif -%}
                    <span class="lm-text-clip">{{ display_product.title | escape }}</span>
                  </span>
                {%- endif -%}

                {%- if section.settings.like_text != blank -%}
                  <span class="rw-footer-likes{% unless section.settings.show_product %} rw-footer-likes--full{% endunless %}">
                    <span>{{ section.settings.like_text }}</span>
                    <span class="rw-like-dislike-icons" aria-hidden="true">
                      <svg enable-background="new 0 0 949.3 949.3" viewBox="0 0 949.3 949.3" xmlns="http://www.w3.org/2000/svg"><path d="m899.3 338.1-355.3-0.4s20.6-84.3 24.3-123.8c2.5-27 3.101-53.9-3.1-80.5-9.2-40-19.5-65-35.9-96-8.8-16.4-25.8-26.6-44.3-26.6h-68.8c-27.7 0-50.101 22.5-50 50.2 0.2 46.3 0.2 108.1-0.8 110.2-27 56.8-58.3 111.3-93.6 163.3-16.1 23.8-33 46.9-52.6 68-8.6 9.2-13.3 21.4-13.3 33.9v437.2c0 12.898 5 25.398 14 34.699 13.4 13.801 37.4 30.199 76.8 30.199 124.3-0.5 325.7-1.6 468.9-0.6 17.9 0.1 34.5-9.299 43.5-24.799l126.3-216.2c8.6-15 13.1-32 13.199-49.299l0.7-259.3c1e-3 -27.7-22.399-50.1-49.999-50.2z"/><path d="m94.8 409.5h-44.8c-27.6 0-50 22.4-50 50v429c0 27.602 22.4 50 50 50h44.7c27.6 0 50-22.398 50-50v-429c0.1-27.6-22.3-50-49.9-50z"/></svg>
                      {{ block.settings.like_size }}
                      <svg enable-background="new 0 0 512 512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="m495.97 297.23-24.695 14.225c-9.711 5.598-20.727 8.543-31.945 8.543h-71.329c-8.836 0-16 7.164-16 16v132.16c0 15.375-12.469 27.84-27.844 27.84h-0.094c-11.977 0-22.617-7.668-26.406-19.035l-30.719-80.355c-7.117-18.611-19.844-34.547-36.422-45.598l-70.515-47.012v-240h14.273c11.602 0 22.977-3.152 32.93-9.121l49.594-29.758c9.953-5.969 21.328-9.121 32.93-9.121h136.94c13.852 0 27.32 4.492 38.398 12.801l34.141 25.6c8.054 6.042 12.796 15.527 12.796 25.599v189.5c0 11.443-6.109 22.016-16.031 27.728z"/><path d="m128 304v-240c0-17.672-14.328-32-32-32h-96v304h96c17.672 0 32-14.326 32-32zm-32-208c0 17.672-14.328 32-32 32s-32-14.328-32-32 14.328-32 32-32 32 14.328 32 32z"/></svg>
                      {{ block.settings.dislike_size }}
                    </span>
                  </span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
    {%- if section.settings.show_border -%}
      <lr></lr>
    {%- endif -%}
  </div>
</div>

{%- comment -%}
  Hidden SVG sprite for Lumin Review stars. Include once per section.
  Accepts: section {Object}
{%- endcomment -%}
<svg class="lumin-review-star-sprite" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <linearGradient id="lumin-star-half-{{ section.id }}" x1="0" x2="100%" y1="0" y2="0">
      <stop offset="50%" stop-color="var(--lr-feature-color)"></stop>
      <stop offset="50%" stop-color="var(--lr-inactive-star-color)"></stop>
    </linearGradient>
    <symbol id="lumin-star-{{ section.id }}" viewBox="0 0 24 24">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
    </symbol>
  </defs>
</svg>

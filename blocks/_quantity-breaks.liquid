  assign gift_custom_3_unlock = block_settings.gift_custom_3_unlock_at | default: 'option_3'
  assign gift_custom_3_position_num = block_settings.gift_custom_3_position | default: '6' | plus: 0
  assign gift_custom_show_price = block_settings.gift_custom_show_price
  assign gift_custom_2_show_price = block_settings.gift_custom_2_show_price
  assign gift_custom_3_show_price = block_settings.gift_custom_3_show_price

  if gift_custom_enabled or gift_custom_2_enabled or gift_custom_3_enabled
    assign c1_at_1 = 0
    if gift_custom_enabled and gift_custom_position_num <= 1
      assign c1_at_1 = 1
    endif
    assign c2_at_1 = 0
    if gift_custom_2_enabled and gift_custom_2_position_num <= 1
      assign c2_at_1 = 1
    endif
    assign c3_at_1 = 0
    if gift_custom_3_enabled and gift_custom_3_position_num <= 1
      assign c3_at_1 = 1
    endif
    assign customs_at_1 = c1_at_1 | plus: c2_at_1 | plus: c3_at_1

    assign c1_at_2 = 0
    if gift_custom_enabled and gift_custom_position_num <= 2
      assign c1_at_2 = 1
    endif
    assign c2_at_2 = 0
    if gift_custom_2_enabled and gift_custom_2_position_num <= 2

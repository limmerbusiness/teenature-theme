{%- liquid

  # Free gifts config
  assign free_gifts_enabled = block_settings.free_gifts_enabled
  assign free_gifts_heading = block_settings.free_gifts_heading | default: '<p>Free Gift Set</p>'
  assign free_gifts_style = block_settings.free_gifts_style | default: 'card'

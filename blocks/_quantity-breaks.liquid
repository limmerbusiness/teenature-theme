      endif
      if gift_custom_2_position_num >= 3
        assign gift_custom_2_order = gift_custom_2_order | plus: 1
      endif
      if gift_custom_2_position_num >= 4
        assign gift_custom_2_order = gift_custom_2_order | plus: 1
      endif
      if gift_custom_2_position_num >= 5
        assign gift_custom_2_order = gift_custom_2_order | plus: 1
      endif
      if gift_custom_2_position_num >= 6
        assign gift_custom_2_order = gift_custom_2_order | plus: 1
      endif
      if gift_custom_enabled and gift_custom_position_num <= gift_custom_2_position_num
        assign gift_custom_2_order = gift_custom_2_order | plus: 1
      endif
      if gift_custom_3_enabled and gift_custom_3_position_num < gift_custom_2_position_num
        assign gift_custom_2_order = gift_custom_2_order | plus: 1
      endif
    endif

    if gift_custom_3_enabled

  {%- capture option_5_compare_price_formatted -%}{% render 'price-split', context: 'quantity_breaks', cents: option_5_compare_price %}{%- endcapture -%}
{%- endif -%}
{%- if option_6_enabled and option_6_quantity > 0 -%}

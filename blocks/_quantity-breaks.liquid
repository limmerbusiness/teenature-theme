    {%- capture option_2_per_unit_compare_price_formatted -%}{% render 'price-split', context: 'quantity_breaks', cents: option_2_per_unit_compare_price %}{%- endcapture -%}
  {%- endif -%}
  {%- if option_3_enabled and option_3_quantity > 0 -%}

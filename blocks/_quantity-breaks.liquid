{%- liquid
  
  # Calculate per-unit prices if enabled
  if block_settings.show_price_per_unit == true
    if option_1_enabled == true and option_1_quantity > 0
      assign option_1_per_unit_price = option_1_final_price | divided_by: option_1_quantity
      assign option_1_per_unit_compare_price = option_1_compare_price | divided_by: option_1_quantity
    else
      assign option_1_per_unit_price = 0
      assign option_1_per_unit_compare_price = 0
    endif
    if option_2_enabled == true and option_2_quantity > 0
      assign option_2_per_unit_price = option_2_final_price | divided_by: option_2_quantity
      assign option_2_per_unit_compare_price = option_2_compare_price | divided_by: option_2_quantity
    else
      assign option_2_per_unit_price = 0
      assign option_2_per_unit_compare_price = 0
    endif
    if option_3_enabled == true and option_3_quantity > 0
      assign option_3_per_unit_price = option_3_final_price | divided_by: option_3_quantity
      assign option_3_per_unit_compare_price = option_3_compare_price | divided_by: option_3_quantity
    else
      assign option_3_per_unit_price = 0
      assign option_3_per_unit_compare_price = 0
    endif
    if option_4_enabled == true and option_4_quantity > 0
      assign option_4_per_unit_price = option_4_final_price | divided_by: option_4_quantity
      assign option_4_per_unit_compare_price = option_4_compare_price | divided_by: option_4_quantity
    else
      assign option_4_per_unit_price = 0
      assign option_4_per_unit_compare_price = 0
    endif
    if option_5_enabled == true and option_5_quantity > 0
      assign option_5_per_unit_price = option_5_final_price | divided_by: option_5_quantity
      assign option_5_per_unit_compare_price = option_5_compare_price | divided_by: option_5_quantity
    else
      assign option_5_per_unit_price = 0
      assign option_5_per_unit_compare_price = 0
    endif
    if option_6_enabled == true and option_6_quantity > 0
      assign option_6_per_unit_price = option_6_final_price | divided_by: option_6_quantity
      assign option_6_per_unit_compare_price = option_6_compare_price | divided_by: option_6_quantity
    else
      assign option_6_per_unit_price = 0
      assign option_6_per_unit_compare_price = 0
    endif

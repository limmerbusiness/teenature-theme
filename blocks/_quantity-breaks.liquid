    assign gift_1_order = 1 | plus: customs_at_1
    assign gift_2_order = 2 | plus: customs_at_2
    assign gift_3_order = 3 | plus: customs_at_3

    if gift_custom_enabled
      assign gift_custom_1_order = 1
      if gift_custom_position_num >= 2
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
      if gift_custom_position_num >= 3
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
      if gift_custom_position_num >= 4
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
      if gift_custom_position_num >= 5
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
      if gift_custom_position_num >= 6
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
      if gift_custom_2_enabled and gift_custom_2_position_num < gift_custom_position_num
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
      if gift_custom_3_enabled and gift_custom_3_position_num < gift_custom_position_num
        assign gift_custom_1_order = gift_custom_1_order | plus: 1
      endif
    endif

    if gift_custom_2_enabled

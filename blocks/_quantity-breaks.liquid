  assign free_gifts_per_row_mobile = block_settings.free_gifts_per_row_mobile | default: '2'
  assign free_gifts_badge_display = block_settings.free_gifts_badge_display | default: 'free'
  assign free_gifts_background_enabled = block_settings.free_gifts_background_enabled
  assign gift_1_product = block_settings.gift_1_product
  assign gift_2_product = block_settings.gift_2_product
  assign gift_3_product = block_settings.gift_3_product
  assign gift_1_unlock = block_settings.gift_1_unlock_at | default: 'option_2'
  assign gift_2_unlock = block_settings.gift_2_unlock_at | default: 'option_2'
  assign gift_3_unlock = block_settings.gift_3_unlock_at | default: 'option_3'

  assign gift_custom_enabled = block_settings.gift_custom_enabled
  assign gift_custom_name = block_settings.gift_custom_name
  assign gift_custom_image = block_settings.gift_custom_image

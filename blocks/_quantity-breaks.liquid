      if gift_custom_3_position_num >= 2
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
      if gift_custom_3_position_num >= 3
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
      if gift_custom_3_position_num >= 4
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
      if gift_custom_3_position_num >= 5
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
      if gift_custom_3_position_num >= 6
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
      if gift_custom_enabled and gift_custom_position_num <= gift_custom_3_position_num
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
      if gift_custom_2_enabled and gift_custom_2_position_num <= gift_custom_3_position_num
        assign gift_custom_3_order = gift_custom_3_order | plus: 1
      endif
    endif
  endif

  assign gift_discount_enabled = block_settings.gift_discount_enabled
  assign gift_discount_type = block_settings.gift_discount_type | default: 'percentage'
  assign gift_discount_value = block_settings.gift_discount_value | default: 50
  assign gift_discount_amount = block_settings.gift_discount_amount | default: 0
  assign gift_discount_code = block_settings.gift_discount_code | default: ''

  assign option_1_gifts_count = 0
  assign option_2_gifts_count = 0
  assign option_3_gifts_count = 0
  assign option_4_gifts_count = 0
  assign option_5_gifts_count = 0
  assign option_6_gifts_count = 0
  if free_gifts_enabled
    if gift_1_product != blank and gift_1_unlock == 'option_1'
      assign option_1_gifts_count = option_1_gifts_count | plus: 1
    endif
    if gift_2_product != blank and gift_2_unlock == 'option_1'
      assign option_1_gifts_count = option_1_gifts_count | plus: 1
    endif
    if gift_3_product != blank and gift_3_unlock == 'option_1'
      assign option_1_gifts_count = option_1_gifts_count | plus: 1
    endif
    if gift_custom_enabled and gift_custom_unlock == 'option_1'
      assign option_1_gifts_count = option_1_gifts_count | plus: 1
    endif
    if gift_custom_2_enabled and gift_custom_2_unlock == 'option_1'
      assign option_1_gifts_count = option_1_gifts_count | plus: 1
    endif
    if gift_custom_3_enabled and gift_custom_3_unlock == 'option_1'
      assign option_1_gifts_count = option_1_gifts_count | plus: 1
    endif

    assign option_2_gifts_count = option_1_gifts_count
    if gift_1_product != blank and gift_1_unlock == 'option_2'
      assign option_2_gifts_count = option_2_gifts_count | plus: 1
    endif
    if gift_2_product != blank and gift_2_unlock == 'option_2'
      assign option_2_gifts_count = option_2_gifts_count | plus: 1
    endif
    if gift_3_product != blank and gift_3_unlock == 'option_2'
      assign option_2_gifts_count = option_2_gifts_count | plus: 1
    endif
    if gift_custom_enabled and gift_custom_unlock == 'option_2'
      assign option_2_gifts_count = option_2_gifts_count | plus: 1
    endif
    if gift_custom_2_enabled and gift_custom_2_unlock == 'option_2'
      assign option_2_gifts_count = option_2_gifts_count | plus: 1
    endif
    if gift_custom_3_enabled and gift_custom_3_unlock == 'option_2'
      assign option_2_gifts_count = option_2_gifts_count | plus: 1
    endif

    assign option_3_gifts_count = option_2_gifts_count
    if gift_1_product != blank and gift_1_unlock == 'option_3'
      assign option_3_gifts_count = option_3_gifts_count | plus: 1
    endif
    if gift_2_product != blank and gift_2_unlock == 'option_3'
      assign option_3_gifts_count = option_3_gifts_count | plus: 1
    endif
    if gift_3_product != blank and gift_3_unlock == 'option_3'
      assign option_3_gifts_count = option_3_gifts_count | plus: 1
    endif
    if gift_custom_enabled and gift_custom_unlock == 'option_3'
      assign option_3_gifts_count = option_3_gifts_count | plus: 1
    endif
    if gift_custom_2_enabled and gift_custom_2_unlock == 'option_3'
      assign option_3_gifts_count = option_3_gifts_count | plus: 1
    endif
    if gift_custom_3_enabled and gift_custom_3_unlock == 'option_3'
      assign option_3_gifts_count = option_3_gifts_count | plus: 1
    endif

    assign option_4_gifts_count = option_3_gifts_count
    if gift_1_product != blank and gift_1_unlock == 'option_4'
      assign option_4_gifts_count = option_4_gifts_count | plus: 1
    endif
    if gift_2_product != blank and gift_2_unlock == 'option_4'
      assign option_4_gifts_count = option_4_gifts_count | plus: 1
    endif
    if gift_3_product != blank and gift_3_unlock == 'option_4'
      assign option_4_gifts_count = option_4_gifts_count | plus: 1
    endif
    if gift_custom_enabled and gift_custom_unlock == 'option_4'
      assign option_4_gifts_count = option_4_gifts_count | plus: 1
    endif
    if gift_custom_2_enabled and gift_custom_2_unlock == 'option_4'
      assign option_4_gifts_count = option_4_gifts_count | plus: 1
    endif
    if gift_custom_3_enabled and gift_custom_3_unlock == 'option_4'
      assign option_4_gifts_count = option_4_gifts_count | plus: 1
    endif

    assign option_5_gifts_count = option_4_gifts_count
    if gift_1_product != blank and gift_1_unlock == 'option_5'
      assign option_5_gifts_count = option_5_gifts_count | plus: 1
    endif
    if gift_2_product != blank and gift_2_unlock == 'option_5'
      assign option_5_gifts_count = option_5_gifts_count | plus: 1
    endif
    if gift_3_product != blank and gift_3_unlock == 'option_5'
      assign option_5_gifts_count = option_5_gifts_count | plus: 1
    endif
    if gift_custom_enabled and gift_custom_unlock == 'option_5'
      assign option_5_gifts_count = option_5_gifts_count | plus: 1
    endif
    if gift_custom_2_enabled and gift_custom_2_unlock == 'option_5'
      assign option_5_gifts_count = option_5_gifts_count | plus: 1
    endif
    if gift_custom_3_enabled and gift_custom_3_unlock == 'option_5'
      assign option_5_gifts_count = option_5_gifts_count | plus: 1
    endif

    assign option_6_gifts_count = option_5_gifts_count
    if gift_1_product != blank and gift_1_unlock == 'option_6'
      assign option_6_gifts_count = option_6_gifts_count | plus: 1
    endif
    if gift_2_product != blank and gift_2_unlock == 'option_6'
      assign option_6_gifts_count = option_6_gifts_count | plus: 1
    endif
    if gift_3_product != blank and gift_3_unlock == 'option_6'
      assign option_6_gifts_count = option_6_gifts_count | plus: 1
    endif
    if gift_custom_enabled and gift_custom_unlock == 'option_6'
      assign option_6_gifts_count = option_6_gifts_count | plus: 1
    endif
    if gift_custom_2_enabled and gift_custom_2_unlock == 'option_6'
      assign option_6_gifts_count = option_6_gifts_count | plus: 1
    endif
    if gift_custom_3_enabled and gift_custom_3_unlock == 'option_6'
      assign option_6_gifts_count = option_6_gifts_count | plus: 1
    endif
  endif

  assign display_scope = block_settings.display_scope | default: 'all'
  assign show_quantity_breaks = false
  if product != blank
    if display_scope == 'all'
      assign show_quantity_breaks = true
    elsif display_scope == 'selected_products'
      assign show_quantity_breaks = false
      if block_settings.display_products != blank
        for display_product in block_settings.display_products
          if display_product.id == product.id
            assign show_quantity_breaks = true
          endif
        endfor
      endif
    elsif display_scope == 'collection'
      assign show_quantity_breaks = false
      if block_settings.display_collections != blank
        for target_collection in block_settings.display_collections
          for product_collection in product.collections
            if product_collection.id == target_collection.id
              assign show_quantity_breaks = true
            endif
          endfor
        endfor
      endif
    endif
  endif
-%}


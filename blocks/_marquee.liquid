

{% assign block_settings = block.settings %}
{% assign gap_between_elements = block_settings.gap_between_elements %}

{%- comment -%}
  Senkrechte Variante: immer eine Zeile sichtbar, sie kommt von unten, bleibt
  stehen und verschwindet nach oben.

  Das Markup bleibt dabei das des Themes, weil eine Datei nur EIN
  content_for 'blocks' enthalten darf. Umgebaut wird per CSS:
  - die waagerechte Animation wird abgeschaltet
  - die vom Theme-Skript erzeugten Kopien werden ausgeblendet
  - die Zeilen liegen per Grid uebereinander, dadurch richtet sich die Hoehe
    nach der groessten Zeile
  - jede Zeile bekommt ihren eigenen Startversatz
{%- endcomment -%}

{%- if block_settings.motion_axis == 'vertical' -%}
  {%- liquid
    assign line_count = block.blocks.size
    if line_count < 1
      assign line_count = 1
    endif
    assign per_line = block_settings.line_duration
    assign total = per_line | times: line_count
    assign seg = 100.0 | divided_by: line_count
    assign in_end = seg | times: 0.16
    assign hold_end = seg | times: 0.84
  -%}

  {%- style -%}
    .kokoro-vaxis--{{ block.id }} {
      overflow: hidden;
    }

    .kokoro-vaxis--{{ block.id }} .marquee__wrapper {
      animation: none;
      display: block;
      width: 100%;
      white-space: normal;
    }

    .kokoro-vaxis--{{ block.id }} .marquee__content {
      display: block;
      min-width: 0;
    }

    /* Die Kopien des Theme-Skripts fuellen die BREITE - hier nicht gebraucht. */
    .kokoro-vaxis--{{ block.id }} .marquee__content[aria-hidden='true'],
    .kokoro-vaxis--{{ block.id }} .marquee__content > .marquee__repeated-items:not(:first-child) {
      display: none;
    }

    .kokoro-vaxis--{{ block.id }} .marquee__repeated-items {
      display: grid;
      min-width: 0;
      width: 100%;
      justify-items: {{ block_settings.vertical_alignment_text }};
    }

    .kokoro-vaxis--{{ block.id }} .marquee__repeated-items > * {
      grid-area: 1 / 1;
      opacity: 0;
      animation: kokoro-vticker-{{ block.id }} {{ total }}s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    }

    {%- for i in (1..line_count) -%}
      {%- assign delay = forloop.index0 | times: per_line -%}
      .kokoro-vaxis--{{ block.id }} .marquee__repeated-items > *:nth-child({{ i }}) {
        animation-delay: {{ delay }}s;
      }
    {%- endfor -%}

    @keyframes kokoro-vticker-{{ block.id }} {
      0% {
        opacity: 0;
        transform: translateY(110%);
      }
      {{ in_end }}% {
        opacity: 1;
        transform: translateY(0);
      }
      {{ hold_end }}% {
        opacity: 1;
        transform: translateY(0);
      }
      {{ seg }}% {
        opacity: 0;
        transform: translateY(-110%);
      }
      100% {
        opacity: 0;
        transform: translateY(-110%);
      }
    }

    /* Ohne Bewegung bleibt die erste Zeile einfach stehen. */
    @media (prefers-reduced-motion: reduce) {
      .kokoro-vaxis--{{ block.id }} .marquee__repeated-items > * {
        animation: none;
        opacity: 0;
      }
      .kokoro-vaxis--{{ block.id }} .marquee__repeated-items > *:first-child {
        opacity: 1;
      }
    }
  {%- endstyle -%}
{%- endif -%}

<script
  src="{{ 'marquee.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<marquee-component
  class="
    spacing-style
    gap-style
    {% if block_settings.motion_axis == 'vertical' %}kokoro-vaxis--{{ block.id }}{% endif %}
    {% if block_settings.inherit_color_scheme == false %}color-{{ block_settings.color_scheme }}{% endif %}
  "
  style="
    {%- render 'spacing-style', settings: block_settings %};
    {% render 'gap-style', value: gap_between_elements, name: 'marquee-gap' %}
    --marquee-direction: {{ block_settings.movement_direction }};
    {%- if block_settings.transparent_background == true -%}background-color: transparent;{%- endif -%}
  "
  data-speed-factor="25"
  data-movement-direction="{{ block_settings.movement_direction }}"
>
  <div
    class="marquee__wrapper"
    ref="wrapper"
  >
    <div
      class="marquee__content"
      ref="content"
    >
      <div
        class="marquee__repeated-items"
        ref="marqueeItems[]"
      >
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</marquee-component>

{% stylesheet %}
  marquee-component {
    display: block;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-background);
  }

  .marquee__wrapper {
    display: flex;
    gap: var(--marquee-gap);
    width: fit-content;
    white-space: nowrap;
  }

  .marquee__content {
    min-width: max-content;
    display: flex;
    gap: var(--marquee-gap);
  }

  .marquee__content :is(p, h1, h2, h3, h4, h5, h6) {
    white-space: nowrap;
  }

  .marquee__content .marquee__repeated-items * {
    max-width: none;
  }

  .marquee__repeated-items {
    min-width: max-content;
    display: flex;
    gap: var(--marquee-gap);
    align-items: center;
    justify-content: center;
  }

  .marquee__repeated-items > * {
    align-content: center;
  }

  .hero__content-wrapper.layout-panel-flex--column marquee-component {
    --margin-inline: var(--full-page-margin-inline-offset);

    width: -webkit-fill-available;
    min-height: max-content;
  }

  @media (prefers-reduced-motion: no-preference) {
    marquee-component:not([data-disabled]) .marquee__wrapper {
      animation: marquee-motion var(--marquee-speed) linear infinite var(--marquee-direction);
    }
  }

  @keyframes marquee-motion {
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.marquee",
  "tag": null,
  "blocks": [
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "motion_axis",
      "label": "Bewegung",
      "options": [
        { "value": "horizontal", "label": "Seitlich laufend" },
        { "value": "vertical", "label": "Von unten nach oben" }
      ],
      "default": "horizontal",
      "info": "Bei „Von unten nach oben“ ist immer nur eine Zeile sichtbar. Sie kommt von unten, bleibt kurz stehen und verschwindet nach oben. Jede Zeile ist ein eigener Text-Block."
    },
    {
      "type": "range",
      "id": "line_duration",
      "label": "Dauer pro Zeile",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 3,
      "visible_if": "{{ block.settings.motion_axis == 'vertical' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_text",
      "label": "Ausrichtung",
      "options": [
        { "value": "start", "label": "Links" },
        { "value": "center", "label": "Mittig" },
        { "value": "end", "label": "Rechts" }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.motion_axis == 'vertical' }}"
    },
    {
      "type": "select",
      "id": "movement_direction",
      "label": "t:settings.motion_direction",
      "options": [
        {
          "value": "reverse",
          "label": "t:options.forward"
        },
        {
          "value": "normal",
          "label": "t:options.reverse"
        }
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.motion_axis == 'horizontal' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "checkbox",
      "id": "transparent_background",
      "label": "t:settings.transparent_background",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_between_elements",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.motion_axis == 'horizontal' }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.marquee",
      "category": "t:categories.decorative",
      "blocks": {
        "text": {
          "type": "text",
          "settings": {
            "text": "t:html_defaults.make_things_better",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "var(--font-size--h2)",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "none",
            "wrap": "nowrap",
            "width": "fit-content"
          }
        }
      },
      "block_order": ["text"]
    }
  ]
}
{% endschema %}

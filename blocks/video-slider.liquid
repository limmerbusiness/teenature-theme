      "content": "t:sections.video-slider.video_settings"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:options.aspect_ratio",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "widescreen",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "t:settings.enable_video_autoplay",
      "default": false,
      "info": "t:info.video_autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay_current_slide_only",
      "label": "Autoplay current slide only",
      "default": true,
      "info": "When video autoplay is off, only play the visible slide videos."
    },
    {
      "type": "checkbox",
      "id": "loop_videos",
      "label": "t:settings.video_loop",
      "default": true
    },
    {
      "type": "range",
      "id": "video_border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "video_background_color",
      "label": "t:content.background_video",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "show_play_overlay",
      "label": "Show play overlay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable video popup",
      "default": false,
      "info": "Open videos in a fullscreen popup when clicked."
    },
    {
      "type": "header",
      "content": "t:sections.video-slider.play_button"
    },
    {
      "type": "range",
      "id": "play_button_size",

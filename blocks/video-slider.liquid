<div class="block-video-slider block-video-slider--{{ block.id }}" {{ block.shopify_attributes }}>
  {% render 'video-slider', block: block %}
</div>

{% style %}
  .block-video-slider--{{ block.id }} {
    width: 100%;
    max-width: 100%;
  }
{% endstyle %}

{% schema %}

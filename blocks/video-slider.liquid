      "type": "checkbox",
      "id": "video_enabled_1",
      "label": "t:sections.video-slider.video_enabled_1",
      "default": true
    },
    {
      "type": "video_url",
      "id": "video_url_1",
      "label": "t:sections.video-slider.video_url",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "video",
      "id": "video_shopify_1",
      "label": "t:sections.video-slider.video_shopify"
    },
    {
      "type": "text",

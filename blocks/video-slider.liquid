    {
      "type": "header",
      "content": "t:sections.video-slider.slider_behavior"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "t:sections.video-slider.loop",
      "default": true
    },
    {
      "type": "select",
      "id": "slider_type",
      "label": "Slider autoplay type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "interval",
          "label": "Interval"
        },
        {
          "value": "smooth",
          "label": "Smooth scroll"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.video-slider.autoplay",
      "default": false,
      "info": "Legacy setting. Use slider autoplay type when possible."
    },
    {
      "type": "checkbox",
      "id": "autoplay_smooth",
      "label": "t:sections.video-slider.autoplay_smooth",
      "default": false,
      "info": "t:info.autoplay_smooth",
      "visible_if": "{{ block.settings.autoplay }}"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "t:sections.video-slider.autoplay_delay",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ block.settings.slider_type == 'interval' or block.settings.autoplay }}"
    },
    {
      "type": "range",
      "id": "auto_slide_delay",
      "label": "Auto slide delay",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ block.settings.slider_type == 'interval' }}"
    },
    {
      "type": "range",
      "id": "smooth_scroll_speed",
      "label": "Smooth scroll speed",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 65,
      "visible_if": "{{ block.settings.slider_type == 'smooth' or block.settings.autoplay_smooth }}"
    },
    {
      "type": "range",
      "id": "autoplay_smooth_duration",
      "label": "t:sections.video-slider.autoplay_smooth_duration",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 3,
      "visible_if": "{{ block.settings.autoplay_smooth }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay_reverse",
      "label": "t:sections.video-slider.autoplay_reverse",
      "default": false,
      "visible_if": "{{ block.settings.slider_type != 'none' or block.settings.autoplay }}"
    },

      "label": "t:settings.hover_background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "play_button_icon_color",
      "label": "t:content.icon",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "t:sections.video-slider.mute_button"
    },
    {
      "type": "range",
      "id": "mute_button_size",
      "label": "t:settings.size",
      "min": 20,
      "max": 56,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mute_button_offset",
      "label": "t:sections.video-slider.offset_from_corner",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mute_button_opacity",
      "label": "t:settings.opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "default": 80

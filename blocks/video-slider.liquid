    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "label": "t:sections.video-slider.slides_per_view_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_per_view_mobile",
      "label": "t:sections.video-slider.slides_per_view_mobile",

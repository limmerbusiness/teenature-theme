
{%- comment -%}
  Eigene Ergaenzungen, alle unabhaengig von der Typografie-Voreinstellung:
  - freie Textfarbe
  - Schatten fuer Lesbarkeit auf Fotos
  - getrennte Schriftgroessen fuer Computer und Handy
  - Farbverlauf ueber eckige Klammern im Text

  Die theme-eigenen Farboptionen haengen an `type_preset != 'rte'` und sind
  deshalb bei Voreinstellung "Standard" gar nicht sichtbar. Darum hier eigene.
{%- endcomment -%}

{%- if block.settings.kokoro_gradient_on -%}
  {%- style -%}
    .text-block--{{ block.id }} .kokoro-grad {
      background-image: linear-gradient(
        {{ block.settings.kokoro_gradient_direction }},
        {{ block.settings.kokoro_gradient_start }},
        {{ block.settings.kokoro_gradient_end }}
      );
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  {%- endstyle -%}

  <script>
    (function () {
      window.kokoroGradIds = window.kokoroGradIds || [];
      if (window.kokoroGradIds.indexOf('{{ block.id }}') === -1) {
        window.kokoroGradIds.push('{{ block.id }}');
      }

      function paint(root) {
        if (root.getAttribute('data-kokoro-grad')) return;
        root.setAttribute('data-kokoro-grad', '1');

        var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
        var nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);

        nodes.forEach(function (node) {
          var text = node.nodeValue;
          if (!text || text.indexOf('[') === -1 || text.indexOf(']') === -1) return;

          var fragment = document.createDocumentFragment();
          var pattern = /\[([^\]]+)\]/g;
          var last = 0;
          var match;

          while ((match = pattern.exec(text)) !== null) {
            if (match.index > last) {
              fragment.appendChild(document.createTextNode(text.slice(last, match.index)));
            }
            var span = document.createElement('span');
            span.className = 'kokoro-grad';
            span.textContent = match[1];
            fragment.appendChild(span);
            last = pattern.lastIndex;
          }

          if (last === 0) return;
          if (last < text.length) {
            fragment.appendChild(document.createTextNode(text.slice(last)));
          }
          if (node.parentNode) node.parentNode.replaceChild(fragment, node);
        });
      }

      function run() {
        try {
          (window.kokoroGradIds || []).forEach(function (id) {
            document.querySelectorAll('.text-block--' + id).forEach(paint);
          });
        } catch (error) {
          /* Lieber unveraenderter Text als gar keiner. */
        }
      }

      run();
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
      }

      if (!window.kokoroGradObserver) {
        var pending = null;
        window.kokoroGradObserver = new MutationObserver(function () {
          window.clearTimeout(pending);
          pending = window.setTimeout(run, 50);
        });
        window.kokoroGradObserver.observe(document.documentElement, {
          childList: true,
          subtree: true,
        });
      }
    })();
  </script>
{%- endif -%}

{%- if block.settings.kokoro_color_on -%}
  {%- style -%}
    .text-block--{{ block.id }},
    .text-block--{{ block.id }} > *,
    .text-block--{{ block.id }} :is(p, span, strong, b, em, i, u, a, li, h1, h2, h3, h4, h5, h6) {
      color: {{ block.settings.kokoro_text_color }};
      -webkit-text-fill-color: {{ block.settings.kokoro_text_color }};
    }

    /* Der Farbverlauf muss die Farbe wieder freigeben, sonst gewinnt sie. */
    .text-block--{{ block.id }} .kokoro-grad {
      -webkit-text-fill-color: transparent;
    }
  {%- endstyle -%}
{%- endif -%}

{%- if block.settings.kokoro_shadow_on -%}
  {%- comment -%}
    Zwei Schatten uebereinander: ein weicher, grosser fuer den Kontrast zum
    Bild und ein harter, kleiner fuer scharfe Buchstabenkanten. Dunkelt nur
    die Flaeche hinter der Schrift ab, nicht das ganze Bild.
  {%- endcomment -%}
  {%- assign shadow_soft = block.settings.kokoro_shadow_strength | divided_by: 100.0 -%}
  {%- assign shadow_hard = block.settings.kokoro_shadow_strength | times: 0.5 | divided_by: 100.0 -%}
  {%- style -%}
    .text-block--{{ block.id }},
    .text-block--{{ block.id }} > *,
    .text-block--{{ block.id }} :is(p, span, strong, b, em, i, h1, h2, h3, h4, h5, h6) {
      text-shadow: 0 2px 14px rgba(0, 0, 0, {{ shadow_soft }}), 0 1px 2px rgba(0, 0, 0, {{ shadow_hard }});
    }
  {%- endstyle -%}
{%- endif -%}

{%- if block.settings.kokoro_font_size_desktop != blank or block.settings.kokoro_font_size_mobile != blank -%}
  {%- style -%}
    {%- if block.settings.kokoro_font_size_desktop != blank -%}
      @media screen and (min-width: 750px) {
        .text-block--{{ block.id }},
        .text-block--{{ block.id }} > * {
          --font-size: {{ block.settings.kokoro_font_size_desktop }};
          font-size: {{ block.settings.kokoro_font_size_desktop }};
        }
      }
    {%- endif -%}
    {%- if block.settings.kokoro_font_size_mobile != blank -%}
      @media screen and (max-width: 749px) {
        .text-block--{{ block.id }},
        .text-block--{{ block.id }} > * {
          --font-size: {{ block.settings.kokoro_font_size_mobile }};
          font-size: {{ block.settings.kokoro_font_size_mobile }};
        }
      }
    {%- endif -%}
  {%- endstyle -%}
{%- endif -%}


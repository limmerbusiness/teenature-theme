

{%- doc -%}
  This block is used to display the add to cart button.
  Intended for product-form.liquid block.

  @param {string} can_add_to_cart - Whether the product can be added to the cart
  @param {string} add_to_cart_text - The text of the add to cart button
{%- enddoc -%}

{% liquid
  assign block_id = block.id | replace: '_', '' | downcase
  assign class = 'add-to-cart-button ' | append: block.settings.style_class | append: ' add-to-cart-custom-' | append: block_id
  assign id = 'BuyButtons-ProductSubmitButton-' | append: block.id

  if can_add_to_cart and block.settings.custom_text != blank
    assign add_to_cart_text = block.settings.custom_text
  endif

  assign icon_mode = 'show'
  if block.settings.enable_customization
    assign icon_mode = block.settings.icon_mode
  endif
%}

<span
  {{ block.shopify_attributes }}
  style="--add-to-cart-font-case: {{ settings.button_text_case }};"
>
  {% render 'add-to-cart-button',
    id: id,
    class: class,
    can_add_to_cart: can_add_to_cart,
    product: closest.product,
    add_to_cart_text: add_to_cart_text,
    icon_mode: icon_mode,
    custom_icon: block.settings.custom_icon,
    subtext: block.settings.subtext,
    data_testid: 'standalone-add-to-cart'
  %}
</span>

{% if block.settings.enable_customization %}
  {% style %}
    .product-form-buttons:has(.add-to-cart-custom-{{ block_id }}) {
      {% if block.settings.height_mode == 'custom' %}--height-buy-buttons: {{ block.settings.button_height }}px;{% endif %}
      --style-border-radius-inputs: {{ block.settings.border_radius }}px;
      --style-border-radius-buttons: {{ block.settings.border_radius }}px;
      --style-border-radius-buttons-primary: {{ block.settings.border_radius }}px;
      --style-border-radius-buttons-secondary: {{ block.settings.border_radius }}px;
    }
    .add-to-cart-custom-{{ block_id }} {
      border-radius: {{ block.settings.border_radius }}px;
      {% if block.settings.border_width > 0 %}border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};{% endif %}
      {% if block.settings.background_color != blank %}--button-background-color: {{ block.settings.background_color }};{% endif %}
      {% if block.settings.text_color != blank %}--button-color: {{ block.settings.text_color }};{% endif %}
      {% if block.settings.hover_effect != 'none' %}transition: color var(--animation-speed) var(--animation-easing), box-shadow var(--animation-speed) var(--animation-easing), background-color var(--animation-speed) var(--animation-easing), transform var(--animation-speed) var(--animation-easing);{% endif %}
    }
    .add-to-cart-custom-{{ block_id }}:hover:not(:disabled) {
      {% if block.settings.hover_background_color != blank %}--button-background-color: {{ block.settings.hover_background_color }};{% endif %}
      {% if block.settings.hover_text_color != blank %}--button-color: {{ block.settings.hover_text_color }};{% endif %}
      {% if block.settings.border_width > 0 and block.settings.hover_border_color != blank %}border-color: {{ block.settings.hover_border_color }};{% endif %}
      {% case block.settings.hover_effect %}
        {% when 'scale' %}transform: scale(1.03);
        {% when 'lift' %}transform: translateY(-2px); box-shadow: var(--shadow-block, 0 6px 16px rgb(0 0 0 / 0.15));
        {% when 'fade' %}opacity: 0.85;
      {% endcase %}
    }
    {%- if block.settings.text_font_size > 0 -%}
    {%- assign atc_icon_size = block.settings.text_font_size | times: 1.3 | round -%}
    .add-to-cart-custom-{{ block_id }} .add-to-cart-text__content {
      font-size: {{ block.settings.text_font_size }}px;
    }
    .add-to-cart-custom-{{ block_id }} .add-to-cart-icon,
    .add-to-cart-custom-{{ block_id }} .add-to-cart-icon > svg {
      width: {{ atc_icon_size }}px;
      height: {{ atc_icon_size }}px;
    }
    .add-to-cart-custom-{{ block_id }} .add-to-cart-custom-icon {
      width: auto;
      height: {{ atc_icon_size }}px;
    }
    {%- endif -%}
    {%- if block.settings.subtext_font_size > 0 -%}
    .add-to-cart-custom-{{ block_id }} .add-to-cart-subtext {
      font-size: {{ block.settings.subtext_font_size }}px;
    }
    {%- endif -%}
  {% endstyle %}
{% endif %}

{% schema %}
{
  "name": "t:names.add_to_cart",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        }
      ],
      "default": "button-secondary"
    },
    {
      "type": "text",
      "id": "custom_text",
      "label": "t:settings.button_text",
      "info": "t:info.add_to_cart_button_text"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "t:settings.subtext",
      "info": "t:info.add_to_cart_subtext"
    },
    {
      "type": "header",
      "content": "t:content.button_style"
    },
    {
      "type": "checkbox",
      "id": "enable_customization",
      "label": "t:settings.enable_button_customization",
      "default": false
    },
    {
      "type": "select",
      "id": "icon_mode",
      "label": "t:settings.icon",
      "info": "t:info.add_to_cart_icon",
      "options": [
        {
          "value": "show",
          "label": "t:options.show"
        },
        {
          "value": "hide",
          "label": "t:options.hide"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "show",
      "visible_if": "{{ block.settings.enable_customization }}"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "t:settings.custom_icon",
      "visible_if": "{{ block.settings.enable_customization and block.settings.icon_mode == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "t:settings.height",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.enable_customization }}"
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "t:settings.button_height",
      "min": 40,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ block.settings.enable_customization and block.settings.height_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background",
      "default": "#000000",
      "visible_if": "{{ block.settings.enable_customization }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.enable_customization }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "default": "#000000",
      "visible_if": "{{ block.settings.enable_customization and block.settings.border_width > 0 }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_customization }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 4,
      "visible_if": "{{ block.settings.enable_customization }}"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "t:settings.text_font_size",
      "info": "t:info.add_to_cart_use_theme_default",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_customization }}"
    },
    {
      "type": "range",
      "id": "subtext_font_size",
      "label": "t:settings.subtext_font_size",
      "info": "t:info.add_to_cart_use_theme_default",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_customization }}"
    },
    {
      "type": "header",
      "content": "t:content.hover",
      "visible_if": "{{ block.settings.enable_customization }}"
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "t:settings.hover_effect",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "scale",
          "label": "t:options.scale"
        },
        {
          "value": "lift",
          "label": "t:options.lift"
        },
        {
          "value": "fade",
          "label": "t:options.fade"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.enable_customization }}"
    },
    {
      "type": "color",
      "id": "hover_background_color",
      "label": "t:settings.hover_background",
      "default": "#3E3E3E",
      "visible_if": "{{ block.settings.enable_customization }}"
    },
    {
      "type": "color",
      "id": "hover_text_color",
      "label": "t:settings.hover_text",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.enable_customization }}"
    },
    {
      "type": "color",
      "id": "hover_border_color",
      "label": "t:settings.hover_border",
      "default": "#000000",
      "visible_if": "{{ block.settings.enable_customization and block.settings.border_width > 0 }}"
    }
  ]
}
{% endschema %}

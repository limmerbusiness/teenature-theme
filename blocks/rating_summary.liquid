      "content": "t:sections.lumin-review.three_star_rating_bar"
    },
    {
      "type": "range",
      "id": "rating_bar_3_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:sections.lumin-review.three_star_bar_width",
      "default": 1
    },
    {
      "type": "text",
      "id": "rating_bar_3_count",
      "label": "t:sections.lumin-review.three_star_count",

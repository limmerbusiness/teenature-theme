{% liquid
  assign name_id = 'ContactForm-name-' | append: block.id
  assign last_id = 'ContactForm-lastname-' | append: block.id
  assign email_id = 'ContactForm-email-' | append: block.id
%}
<div style="display: flex; flex-direction: column; gap: var(--gap-md);" {{ block.shopify_attributes }}>
  <div class="contact-form__form-row">
    <label class="visually-hidden" for="{{ name_id }}">Vorname</label>
    <input
      type="text"
      id="{{ name_id }}"
      class="contact-form__input"
      autocomplete="given-name"
      name="contact[name]"
      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.first_name }}{% endif %}"
      placeholder="Vorname"
    >

    <label class="visually-hidden" for="{{ last_id }}">Nachname</label>
    <input
      type="text"
      id="{{ last_id }}"
      class="contact-form__input"
      autocomplete="family-name"
      name="contact[Nachname]"
      value="{% if form.Nachname %}{{ form.Nachname }}{% elsif customer %}{{ customer.last_name }}{% endif %}"
      placeholder="Nachname"
    >
  </div>

  <label class="visually-hidden" for="{{ email_id }}">
    {{- 'blocks.contact_form.email' | t -}}
    <span aria-hidden="true">*</span>
  </label>
  <input
    type="email"
    id="{{ email_id }}"
    class="contact-form__input"
    autocomplete="email"
    name="contact[email]"
    spellcheck="false"
    autocapitalize="off"
    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
    aria-required="true"
    {% if form.errors contains 'email' %}
      aria-invalid="true"
    {% endif %}
    placeholder="{{ 'blocks.contact_form.email' | t }}"
  >
</div>

{% schema %}
{
  "name": "t:names.contact_form_name_email",
  "tag": null,
  "settings": [],
  "presets": []
}
{% endschema %}

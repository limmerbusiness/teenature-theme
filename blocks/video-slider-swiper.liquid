
{% assign block_id = block.id | replace: '_', '' | downcase %}
{% assign slider_id = 'video-swiper-' | append: block_id %}

{% liquid
  if block.settings.aspect_ratio == 'auto'
    assign aspect_ratio_value = 'auto'
  elsif block.settings.aspect_ratio == 'square'
    assign aspect_ratio_value = '1 / 1'
  elsif block.settings.aspect_ratio == 'portrait'
    assign aspect_ratio_value = '3 / 4'
  elsif block.settings.aspect_ratio == 'widescreen'
    assign aspect_ratio_value = '16 / 9'
  else
    assign aspect_ratio_value = '16 / 9'
  endif
%}

{% style %}
  .lumin-video-swiper-{{ block_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-width: 0;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    {% if block.settings.background %}
      background-color: {{ block.settings.background_color | default: '#00000026' }};
      border-radius: {{ block.settings.corner_radius }}px;
    {% endif %}
  }

  .lumin-video-swiper-{{ block_id }} .lumin-video-swiper-inner-{{ block_id }} {
    overflow: hidden;
    min-width: 0;
    position: relative;
  }

  .lumin-video-swiper-{{ block_id }} .lumin-video-swiper-track-{{ block_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.gap }}px;
    transform: translate3d(0, 0, 0);
    will-change: transform;
    transition: transform 0.5s ease;
    min-width: 0;
  }

  .lumin-video-swiper-{{ block_id }}[data-autoplay-smooth-active] .lumin-video-swiper-track-{{ block_id }} {
    transition-timing-function: linear;
  }

  .lumin-video-swiper-{{ block_id }} .lumin-video-swiper-slide-{{ block_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.slides_per_view_mobile | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.slides_per_view_mobile }});
    width: calc((100% - ({{ block.settings.slides_per_view_mobile | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.slides_per_view_mobile }});
    max-width: calc((100% - ({{ block.settings.slides_per_view_mobile | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.slides_per_view_mobile }});
    {% if block.settings.aspect_ratio == 'auto' %}
    aspect-ratio: 16 / 9;
    {% else %}
    aspect-ratio: {{ aspect_ratio_value }};
    {% endif %}
    height: auto;
    position: relative;
    background-color: {{ block.settings.video_background_color }};
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    box-sizing: border-box;
    contain: layout;
  }

  @media screen and (min-width: 750px) {
    .lumin-video-swiper-{{ block_id }} .lumin-video-swiper-slide-{{ block_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.slides_per_view_desktop | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.slides_per_view_desktop }});
      width: calc((100% - ({{ block.settings.slides_per_view_desktop | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.slides_per_view_desktop }});
      max-width: calc((100% - ({{ block.settings.slides_per_view_desktop | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.slides_per_view_desktop }});
    }
  }

  .lumin-video-swiper-{{ block_id }} .lumin-video-swiper-slide-{{ block_id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lumin-video-swiper-{{ block_id }} .lumin-video-swiper-slide-{{ block_id }} iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: none;
  }

  .lumin-video-swiper-{{ block_id }} .lumin-video-wrapper-{{ block_id }} {
    position: relative;
    width: 100%;
    {% if block.settings.aspect_ratio == 'auto' %}
      height: auto;
    {% else %}
      aspect-ratio: {{ aspect_ratio_value }};
    {% endif %}
  }

  .lumin-video-swiper-{{ block_id }} .lumin-video-wrapper-{{ block_id }}.playing {
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="white" stroke="black" stroke-width="1"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>') 16 16, pointer;
  }

  .lumin-video-swiper-{{ block_id }} .lumin-video-placeholder-{{ block_id }} {
    width: 100%;
    {% if block.settings.aspect_ratio == 'auto' %}
      aspect-ratio: 16 / 9;
    {% else %}
      aspect-ratio: {{ aspect_ratio_value }};
    {% endif %}
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .lumin-video-swiper-{{ block_id }} .lumin-video-placeholder-{{ block_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .lumin-video-empty-state-{{ block_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .lumin-video-play-button-{{ block_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.play_button_size }}px;
    height: {{ block.settings.play_button_size }}px;
    min-width: {{ block.settings.play_button_size }}px;
    min-height: {{ block.settings.play_button_size }}px;
    background-color: {{ block.settings.play_button_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.3s ease;
    opacity: {{ block.settings.play_button_opacity | divided_by: 100.0 }};
    contain: layout style;
  }

  .lumin-video-play-button-{{ block_id }}:hover {
    background-color: {{ block.settings.play_button_hover_color }};
    transform: translate(-50%, -50%) scale(1.1);
    opacity: 1;
  }

  .lumin-video-play-button-{{ block_id }}.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .lumin-video-play-button-{{ block_id }} .icon-play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .lumin-video-play-button-{{ block_id }} .icon-play svg {
    width: calc({{ block.settings.play_button_size }}px * 0.4);
    height: calc({{ block.settings.play_button_size }}px * 0.4);
    min-width: calc({{ block.settings.play_button_size }}px * 0.4);
    min-height: calc({{ block.settings.play_button_size }}px * 0.4);
    flex-shrink: 0;
    color: {{ block.settings.play_button_icon_color }};
  }

  .lumin-video-mute-button-{{ block_id }} {
    position: absolute;
    top: {{ block.settings.mute_button_offset }}px;
    right: {{ block.settings.mute_button_offset }}px;
    width: {{ block.settings.mute_button_size }}px;
    height: {{ block.settings.mute_button_size }}px;
    min-width: {{ block.settings.mute_button_size }}px;
    min-height: {{ block.settings.mute_button_size }}px;
    background-color: {{ block.settings.mute_button_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    transition: opacity 0.3s ease, background-color 0.3s ease;
    opacity: {{ block.settings.mute_button_opacity | divided_by: 100.0 }};
  }

  .lumin-video-mute-button-{{ block_id }}:hover {
    background-color: {{ block.settings.mute_button_hover_color }};
    opacity: 1;
  }

  .lumin-video-mute-button-{{ block_id }} svg {
    width: calc({{ block.settings.mute_button_size }}px * 0.5);
    height: calc({{ block.settings.mute_button_size }}px * 0.5);
    min-width: calc({{ block.settings.mute_button_size }}px * 0.5);
    min-height: calc({{ block.settings.mute_button_size }}px * 0.5);
    flex-shrink: 0;
    fill: {{ block.settings.mute_button_icon_color }};
  }

  .lumin-video-swiper-nav-{{ block_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_icon_color }};
    border: none;
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: opacity 0.3s ease, background-color 0.3s ease;
    opacity: {{ block.settings.nav_button_opacity | divided_by: 100.0 }};
  }

  .lumin-video-swiper-nav-{{ block_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
    opacity: 1;
  }

  .lumin-video-swiper-nav-{{ block_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .lumin-video-swiper-nav-{{ block_id }}.lumin-video-swiper-prev-{{ block_id }} {
    left: {{ block.settings.nav_button_offset }}px;
  }

  .lumin-video-swiper-nav-{{ block_id }}.lumin-video-swiper-next-{{ block_id }} {
    right: {{ block.settings.nav_button_offset }}px;
  }

  .lumin-video-swiper-nav-{{ block_id }} svg {
    width: calc({{ block.settings.nav_button_size }}px * 0.4);
    height: calc({{ block.settings.nav_button_size }}px * 0.4);
    flex-shrink: 0;
  }

  .lumin-video-swiper-dots-{{ block_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: {{ block.settings.dots_margin_top }}px;
    height: calc({{ block.settings.dot_size }}px + 2px);
  }

  .lumin-video-swiper-dot-{{ block_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease;
    padding: 0;
    opacity: 1;
  }

  .lumin-video-swiper-dot-{{ block_id }}.active {
    width: 6px;
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  @media screen and (max-width: 749px) {
    .lumin-video-swiper-nav-{{ block_id }} {
      width: calc({{ block.settings.nav_button_size }}px * 0.8);
      height: calc({{ block.settings.nav_button_size }}px * 0.8);
    }

    .lumin-video-swiper-nav-{{ block_id }} svg {
      width: calc({{ block.settings.nav_button_size }}px * 0.8 * 0.4);
      height: calc({{ block.settings.nav_button_size }}px * 0.8 * 0.4);
    }

    .lumin-video-swiper-nav-{{ block_id }}.lumin-video-swiper-prev-{{ block_id }} {
      left: calc({{ block.settings.nav_button_offset }}px * 0.5);
    }

    .lumin-video-swiper-nav-{{ block_id }}.lumin-video-swiper-next-{{ block_id }} {
      right: calc({{ block.settings.nav_button_offset }}px * 0.5);
    }

    .lumin-video-play-button-{{ block_id }} {
      width: calc({{ block.settings.play_button_size }}px * 0.8);
      height: calc({{ block.settings.play_button_size }}px * 0.8);
    }

    .lumin-video-mute-button-{{ block_id }} {
      width: calc({{ block.settings.mute_button_size }}px * 0.8);
      height: calc({{ block.settings.mute_button_size }}px * 0.8);
      top: calc({{ block.settings.mute_button_offset }}px * 0.5);
      right: calc({{ block.settings.mute_button_offset }}px * 0.5);
    }
  }
{% endstyle %}

<video-swiper-slider-{{ block_id }}
  class="lumin-video-swiper-{{ block_id }} spacing-style"
  id="{{ slider_id }}-wrapper"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
  data-slides-desktop="{{ block.settings.slides_per_view_desktop }}"
  data-slides-mobile="{{ block.settings.slides_per_view_mobile }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-delay="{{ block.settings.autoplay_delay }}"
  data-autoplay-smooth="{{ block.settings.autoplay_smooth }}"
  data-autoplay-smooth-duration="{{ block.settings.autoplay_smooth_duration | default: 3 }}"
  {% if block.settings.autoplay_smooth %}data-autoplay-smooth-active{% endif %}
  data-loop="{{ block.settings.loop }}"
  data-autoplay-reverse="{{ block.settings.autoplay_reverse }}"
  data-video-autoplay="{{ block.settings.video_autoplay }}"
  data-gap="{{ block.settings.gap }}"
>
  <div
    class="lumin-video-swiper-inner-{{ block_id }}"
    id="{{ slider_id }}"
  >
    <div class="lumin-video-swiper-track-{{ block_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign video_url_key = 'video_url_' | append: i
          assign video_shopify_key = 'video_shopify_' | append: i
          assign video_enabled_key = 'video_enabled_' | append: i
          assign video_url = block.settings[video_url_key]
          assign video_shopify = block.settings[video_shopify_key]
          assign video_enabled = block.settings[video_enabled_key]
        %}
        {% if video_enabled %}
        <div class="lumin-video-swiper-slide-{{ block_id }}" data-slide-index="{{ forloop.index0 }}">
          {% if video_shopify %}
            <div class="lumin-video-wrapper-{{ block_id }}" data-video-type="shopify">
              {{
                video_shopify
                | video_tag:
                  image_size: '1100x',
                  controls: false,
                  muted: true,
                  loop: block.settings.loop_videos,
                  autoplay: false
              }}
              {% unless block.settings.video_autoplay %}
                <button class="lumin-video-play-button-{{ block_id }}" type="button" aria-label="{{ 'accessibility.play_video' | t }}">
                  <span class="icon-play">
                    <span class="visually-hidden">{{ 'accessibility.play_video' | t }}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="100%" height="100%" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M15.375 8.48516C16.5417 9.15874 16.5417 10.8427 15.375 11.5163L7.875 15.8464C6.70833 16.52 5.25 15.678 5.25 14.3308L5.25 5.67058C5.25 4.32343 6.70833 3.48146 7.875 4.15504L15.375 8.48516Z"/></svg>
                  </span>
                </button>
              {% endunless %}
              <button class="lumin-video-mute-button-{{ block_id }}" aria-label="Toggle mute">
                <svg class="lumin-mute-icon-{{ block_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="display: none;">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <line x1="23" y1="9" x2="17" y2="15"></line>
                  <line x1="17" y1="9" x2="23" y2="15"></line>
                </svg>
                <svg class="lumin-unmute-icon-{{ block_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                  <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                </svg>
              </button>
            </div>
          {% elsif video_url %}
            <div class="lumin-video-wrapper-{{ block_id }}" data-video-type="external">
              {% if video_url.type == 'youtube' %}
                <iframe
                  src="https://www.youtube.com/embed/{{ video_url.id }}?controls=0&mute=1&loop={{ block.settings.loop_videos | default: 0 }}&playlist={{ video_url.id }}&enablejsapi=1"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {% elsif video_url.type == 'vimeo' %}
                <iframe
                  src="https://player.vimeo.com/video/{{ video_url.id }}?controls=0&muted=1&loop={{ block.settings.loop_videos | default: 0 }}"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {% endif %}
            </div>
          {% else %}
            <div class="lumin-video-placeholder-{{ block_id }}">
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-video' }}
              {% if forloop.first %}
                <div class="lumin-video-empty-state-{{ block_id }}"></div>
              {% endif %}
            </div>
          {% endif %}
        </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.show_navigation %}
      <button
        class="lumin-video-swiper-nav-{{ block_id }} lumin-video-swiper-prev-{{ block_id }}"
        type="button"
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button
        class="lumin-video-swiper-nav-{{ block_id }} lumin-video-swiper-next-{{ block_id }}"
        type="button"
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    {% endif %}
  </div>

  {% if block.settings.show_dots %}
    <div class="lumin-video-swiper-dots-{{ block_id }}"></div>
  {% endif %}
</video-swiper-slider-{{ block_id }}>

<script>
  (function() {
    const NAV_SPEED = 300;
    const gap = {{ block.settings.gap }};

    class VideoSwiperSlider{{ block_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.lastDirection = 'next';
        this.allVideos = [];
        this.autoplayTimer = null;
        this.smoothAutoplayActive = false;
        this.boundOnTransitionEnd = this.onTransitionEnd.bind(this);
        this.boundOnSmoothTransitionEnd = this.onSmoothTransitionEnd.bind(this);
      }

      connectedCallback() {
        this.inner = this.querySelector('.lumin-video-swiper-inner-{{ block_id }}');
        this.track = this.querySelector('.lumin-video-swiper-track-{{ block_id }}');
        this.slides = Array.from(this.querySelectorAll('.lumin-video-swiper-slide-{{ block_id }}'));
        this.prevButton = this.querySelector('.lumin-video-swiper-prev-{{ block_id }}');
        this.nextButton = this.querySelector('.lumin-video-swiper-next-{{ block_id }}');
        this.dotsContainer = this.querySelector('.lumin-video-swiper-dots-{{ block_id }}');

        this.slidesDesktop = parseInt(this.dataset.slidesDesktop) || 3;
        this.slidesMobile = parseInt(this.dataset.slidesMobile) || 2;
        this.loop = this.dataset.loop === 'true';
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySmooth = this.dataset.autoplaySmooth === 'true';
        this.autoplaySmoothDuration = parseInt(this.dataset.autoplaySmoothDuration) || 3;
        this.autoplayDelay = (parseInt(this.dataset.autoplayDelay) || 3) * 1000;
        this.autoplayReverse = this.dataset.autoplayReverse === 'true';
        this.videoAutoplay = this.dataset.videoAutoplay === 'true';
        this.infiniteMode = this.loop && this.slides.length > 0;

        if (this.infiniteMode) {
          this.slides.forEach(slide => {
            const suffixClone = slide.cloneNode(true);
            suffixClone.classList.add('lumin-video-swiper-clone-{{ block_id }}');
            this.track.appendChild(suffixClone);
          });
          this.slides.forEach(slide => {
            const prefixClone = slide.cloneNode(true);
            prefixClone.classList.add('lumin-video-swiper-clone-{{ block_id }}');
            this.track.insertBefore(prefixClone, this.track.firstChild);
          });
          this.currentIndex = this.slides.length;
          this.track.addEventListener('transitionend', this.boundOnTransitionEnd);
        }

        this.updateSlidesPerView();
        this.setupEventListeners();
        this.setupVideoControls();
        this.createDots();
        this.updateSlider();

        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
        if (this.track && this.infiniteMode) {
          this.track.removeEventListener('transitionend', this.boundOnTransitionEnd);
        }
        this.track?.removeEventListener('transitionend', this.boundOnSmoothTransitionEnd);
      }

      getTransitionDuration() {
        if (this.autoplay && this.autoplaySmooth) {
          return this.autoplaySmoothDuration * 1000;
        }
        return NAV_SPEED;
      }

      setTransitionDuration(ms) {
        const easing = this.autoplaySmooth ? 'linear' : 'ease';
        this.track.style.transition = `transform ${ms}ms ${easing}`;
      }

      updateSlidesPerView() {
        this.slidesPerView = window.innerWidth <= 749 ? this.slidesMobile : this.slidesDesktop;
        this.maxIndex = this.infiniteMode
          ? this.slides.length * 2
          : Math.max(0, this.slides.length - this.slidesPerView);
      }

      getSlideStep() {
        const firstSlide = this.infiniteMode ? this.track.children[this.slides.length] : this.slides[0];
        const slideWidth = (firstSlide || this.slides[0])?.offsetWidth || 0;
        return slideWidth + gap;
      }

      setupEventListeners() {
        this.prevButton?.addEventListener('click', () => {
          this.stopAutoplay();
          this.prev(NAV_SPEED);
          if (this.autoplay) this.startAutoplay();
        });

        this.nextButton?.addEventListener('click', () => {
          this.stopAutoplay();
          this.next(NAV_SPEED);
          if (this.autoplay) this.startAutoplay();
        });

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplay) this.startAutoplay();
        });

        window.addEventListener('resize', () => {
          this.updateSlidesPerView();
          this.updateSlider(false);
          this.createDots();
        });
      }

      setupVideoControls() {
        const allSlidesInTrack = this.track.querySelectorAll('.lumin-video-swiper-slide-{{ block_id }}');
        allSlidesInTrack.forEach((slide) => {
          const wrapper = slide.querySelector('.lumin-video-wrapper-{{ block_id }}');
          if (!wrapper) return;

          if (wrapper.dataset.videoType !== 'shopify') return;

          const video = wrapper.querySelector('video');
          const playButton = wrapper.querySelector('.lumin-video-play-button-{{ block_id }}');
          const muteButton = wrapper.querySelector('.lumin-video-mute-button-{{ block_id }}');
          const muteIcon = muteButton?.querySelector('.lumin-mute-icon-{{ block_id }}');
          const unmuteIcon = muteButton?.querySelector('.lumin-unmute-icon-{{ block_id }}');

          if (!video) return;

          this.allVideos.push({ video, muteIcon, unmuteIcon });

          if (this.videoAutoplay) {
            video.play().catch(() => {});
            wrapper.classList.add('playing');
          }

          const updateMuteIcons = (muted) => {
            if (muteIcon && unmuteIcon) {
              muteIcon.style.display = muted ? 'block' : 'none';
              unmuteIcon.style.display = muted ? 'none' : 'block';
            }
          };

          const muteAllOthers = (current) => {
            this.allVideos.forEach(({ video: v, muteIcon: mi, unmuteIcon: ui }) => {
              if (v !== current && !v.muted) {
                v.muted = true;
                if (mi) mi.style.display = 'block';
                if (ui) ui.style.display = 'none';
              }
            });
          };

          playButton?.addEventListener('click', () => {
            muteAllOthers(video);
            video.muted = false;
            updateMuteIcons(false);
            video.play();
            playButton.classList.add('hidden');
            wrapper.classList.add('playing');
          });

          wrapper.addEventListener('click', (e) => {
            if (e.target.closest('.lumin-video-play-button-{{ block_id }}') || e.target.closest('.lumin-video-mute-button-{{ block_id }}')) return;

            if (!video.paused) {
              if (video.muted) {
                muteAllOthers(video);
                video.muted = false;
                updateMuteIcons(false);
              } else {
                video.pause();
                wrapper.classList.remove('playing');
                playButton?.classList.remove('hidden');
              }
            } else {
              muteAllOthers(video);
              video.muted = false;
              updateMuteIcons(false);
              video.play();
              wrapper.classList.add('playing');
              playButton?.classList.add('hidden');
            }
          });

          muteButton?.addEventListener('click', (e) => {
            e.stopPropagation();
            if (video.muted) {
              muteAllOthers(video);
              video.muted = false;
              if (muteIcon) muteIcon.style.display = 'none';
              if (unmuteIcon) unmuteIcon.style.display = 'block';
            } else {
              video.muted = true;
              if (muteIcon) muteIcon.style.display = 'block';
              if (unmuteIcon) unmuteIcon.style.display = 'none';
            }
          });
        });
      }

      createDots() {
        if (!this.dotsContainer) return;

        this.dotsContainer.innerHTML = '';
        const totalDots = this.infiniteMode ? this.slides.length : this.maxIndex + 1;

        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'lumin-video-swiper-dot-{{ block_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => {
            this.stopAutoplay();
            this.goToSlide(i, NAV_SPEED);
            if (this.autoplay) this.startAutoplay();
          });
          this.dotsContainer.appendChild(dot);
        }

        this.updateDots();
      }

      updateDots() {
        if (!this.dotsContainer) return;

        const dots = this.dotsContainer.querySelectorAll('.lumin-video-swiper-dot-{{ block_id }}');
        const effectiveIndex = this.infiniteMode
          ? ((this.currentIndex % this.slides.length) + this.slides.length) % this.slides.length
          : this.currentIndex;
        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === effectiveIndex);
        });
      }

      updateSlider(animate = true) {
        if (this.slides.length === 0) return;

        const step = this.getSlideStep();
        const offset = -(this.currentIndex * step);

        if (animate) {
          this.setTransitionDuration(this.getTransitionDuration());
        } else {
          this.track.style.transition = 'none';
        }

        this.track.style.transform = `translate3d(${offset}px, 0, 0)`;

        if (!animate) {
          this.track.offsetHeight;
          this.setTransitionDuration(this.getTransitionDuration());
        }

        if (this.prevButton) {
          const atStart = this.infiniteMode ? this.currentIndex === this.slides.length : this.currentIndex === 0;
          this.prevButton.disabled = !this.loop && atStart;
        }

        if (this.nextButton) {
          this.nextButton.disabled = !this.loop && this.currentIndex >= this.maxIndex;
        }

        this.updateDots();
      }

      prev(speed = this.getTransitionDuration()) {
        this.lastDirection = 'prev';
        this.setTransitionDuration(speed);
        if (this.currentIndex > 0) {
          this.currentIndex--;
        } else if (this.loop) {
          this.currentIndex = this.infiniteMode ? this.maxIndex - 1 : this.maxIndex;
        }
        this.updateSlider();
      }

      next(speed = this.getTransitionDuration()) {
        this.lastDirection = 'next';
        this.setTransitionDuration(speed);
        if (this.currentIndex < this.maxIndex) {
          this.currentIndex++;
        } else if (this.loop && !this.infiniteMode) {
          this.currentIndex = 0;
        }
        this.updateSlider();
      }

      goToSlide(index, speed = NAV_SPEED) {
        this.lastDirection = index > this.currentIndex ? 'next' : 'prev';
        this.currentIndex = this.infiniteMode ? index + this.slides.length : index;
        this.setTransitionDuration(speed);
        this.updateSlider();
      }

      onTransitionEnd(e) {
        if (e.propertyName !== 'transform' || e.target !== this.track) return;

        if (this.infiniteMode && this.lastDirection === 'next' && this.currentIndex === this.slides.length * 2) {
          this.track.style.transition = 'none';
          this.currentIndex = this.slides.length;
          this.updateSlider(false);
          if (this.smoothAutoplayActive) this.queueSmoothStep();
          return;
        }

        if (this.infiniteMode && this.lastDirection === 'prev' && this.currentIndex === 0) {
          this.track.style.transition = 'none';
          this.currentIndex = this.slides.length;
          this.updateSlider(false);
          if (this.smoothAutoplayActive) this.queueSmoothStep();
        }
      }

      onSmoothTransitionEnd(e) {
        if (e.propertyName !== 'transform' || e.target !== this.track || !this.smoothAutoplayActive) return;
        this.queueSmoothStep();
      }

      startAutoplay() {
        this.stopAutoplay();
        if (!this.autoplay || this.slides.length <= 1) return;

        if (this.autoplaySmooth) {
          this.smoothAutoplayActive = true;
          this.track.removeEventListener('transitionend', this.boundOnSmoothTransitionEnd);
          this.track.addEventListener('transitionend', this.boundOnSmoothTransitionEnd);
          this.queueSmoothStep();
          return;
        }

        this.autoplayTimer = setInterval(() => {
          if (this.autoplayReverse) {
            this.prev(this.getTransitionDuration());
          } else {
            this.next(this.getTransitionDuration());
          }
        }, this.autoplayDelay);
      }

      queueSmoothStep() {
        if (!this.smoothAutoplayActive) return;
        if (this.autoplayReverse) {
          this.prev(this.autoplaySmoothDuration * 1000);
        } else {
          this.next(this.autoplaySmoothDuration * 1000);
        }
      }

      stopAutoplay() {
        this.smoothAutoplayActive = false;
        this.track?.removeEventListener('transitionend', this.boundOnSmoothTransitionEnd);
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }
    }

    if (!customElements.get('video-swiper-slider-{{ block_id }}')) {
      customElements.define('video-swiper-slider-{{ block_id }}', VideoSwiperSlider{{ block_id }});
    }
  })();
</script>


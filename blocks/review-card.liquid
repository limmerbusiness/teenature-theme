{%- liquid
  assign s = block.settings
  assign star_rating = s.star_rating | default: 5
  assign full_stars = star_rating | floor
  assign remainder = star_rating | minus: full_stars
  assign next_after_full = full_stars | plus: 1
  assign position = s.author_position | default: 'bottom'

  # Bei 'inline' wandert nur der Name in die Sternenzeile. Die untere Zeile
  # entfaellt dann ganz, wenn dort weder Bild noch Siegel uebrig bleiben.
  assign show_author_row = true
  if position == 'inline' and s.show_avatar == false and s.show_verified == false
    assign show_author_row = false
  endif
-%}

{%- capture author_html -%}
  <div class="review-card__author review-card__author--{{ position }}">
    {%- if s.show_avatar -%}
      {%- if s.author_image != blank -%}
        <div class="review-card__avatar">
          {{ s.author_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: s.author_name, class: 'review-card__avatar-img' }}
        </div>
      {%- else -%}
        <div class="review-card__avatar review-card__avatar--placeholder">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
        </div>
      {%- endif -%}
    {%- endif -%}
    <div class="review-card__author-info">
      {%- unless position == 'inline' -%}
        <span class="review-card__author-name">{{ s.author_name | default: 'Customer' }}</span>
      {%- endunless -%}
      {%- if s.show_verified -%}
        <span class="review-card__verified">
          <span class="review-card__verified-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zm4.707-12.293a1 1 0 010 1.414l-5 5a1 1 0 01-1.414 0l-3-3a1 1 0 111.414-1.414L11 13.586l4.293-4.293a1 1 0 011.414 0z"/></svg>
          </span>
          <span class="review-card__verified-text">{{ s.verified_text | default: 'Verified Customer' }}</span>
        </span>
      {%- endif -%}
    </div>
  </div>
{%- endcapture -%}

<div
  class="review-card review-card--{{ block.id }}"
  style="
    --review-card-bg: {{ s.background_color | default: '#F8F7F4' }};
    --review-card-text: {{ s.text_color | default: 'rgb(0, 0, 0)' }};
    --review-card-title-size: {{ s.title_size }}px;
    --review-card-body-size: {{ s.body_size }}px;
    --review-card-star-color: {{ s.star_color | default: '#D4AF37' }};
    --review-card-star-size: {{ s.star_size }}px;
    --review-card-radius: {{ s.corner_radius }}px;
    --review-card-border-width: {{ s.border_width }}px;
    --review-card-border-color: {{ s.border_color | default: 'rgba(0, 0, 0, 0.1)' }};
    --review-card-padding: {{ s.padding_top }}px {{ s.padding_sides }}px {{ s.padding_bottom }}px;
    --review-card-avatar-size: {{ s.avatar_size }}px;
    --review-card-verified-color: {{ s.verified_color | default: '#5E887E' }};
    --review-card-name-gap: {{ s.name_gap }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="review-card__inner">
    <div class="review-card__rating-row">
      <div class="review-card__stars" aria-label="{{ star_rating }} out of 5 stars">
        {%- for i in (1..5) -%}
          {%- if i <= full_stars -%}
            <svg class="review-card__star review-card__star--filled" viewBox="0 0 24 24" fill="var(--review-card-star-color)" aria-hidden="true">
              <path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.826 1.608 8.144L12 18.896l-7.544 4.38 1.608-8.144L.587 9.306l8.332-1.151z"/>
            </svg>
          {%- elsif i == next_after_full and remainder > 0 -%}
            <span class="review-card__star review-card__star--half" style="--star-color: var(--review-card-star-color);">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <defs>
                  <linearGradient id="review-card-half-{{ block.id }}">
                    <stop offset="50%" stop-color="var(--star-color)"/>
                    <stop offset="50%" stop-color="rgba(0,0,0,0.08)"/>
                  </linearGradient>
                </defs>
                <path fill="url(#review-card-half-{{ block.id }})" d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.826 1.608 8.144L12 18.896l-7.544 4.38 1.608-8.144L.587 9.306l8.332-1.151z"/>
              </svg>
            </span>
          {%- else -%}
            <svg class="review-card__star review-card__star--empty" viewBox="0 0 24 24" fill="rgba(0,0,0,0.08)" aria-hidden="true">
              <path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.826 1.608 8.144L12 18.896l-7.544 4.38 1.608-8.144L.587 9.306l8.332-1.151z"/>
            </svg>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if position == 'inline' -%}
        <span class="review-card__author-name review-card__author-name--inline">
          {{- s.author_name | default: 'Customer' -}}
        </span>
      {%- endif -%}
    </div>

    {%- if position == 'top' -%}
      {{ author_html }}
    {%- endif -%}

    {%- if s.title != blank -%}
      <h3 class="review-card__title">{{ s.title }}</h3>
    {%- endif -%}

    {%- if s.body != blank -%}
      <div class="review-card__body">{{ s.body }}</div>
    {%- endif -%}

    {%- if position != 'top' and show_author_row -%}
      {{ author_html }}
    {%- endif -%}
  </div>
</div>

<style>
  .review-card--{{ block.id }} {
    --review-card-star-size: {{ s.star_size }}px;
    background-color: var(--review-card-bg);
    color: var(--review-card-text);
    border-radius: var(--review-card-radius);
    border-width: var(--review-card-border-width);
    border-style: solid;
    border-color: var(--review-card-border-color);
    padding: var(--review-card-padding);
  }

  .review-card__inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /*
   * Sterne und Name liegen in einer Zeile. align-items: center zentriert sie
   * zueinander; line-height: 1 am Namen verhindert, dass die Schriftlinie
   * ihn optisch nach unten zieht.
   */
  .review-card__rating-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--review-card-name-gap, 10px);
  }

  .review-card__stars {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .review-card--{{ block.id }} .review-card__star {
    display: inline-block;
    flex-shrink: 0;
    width: var(--review-card-star-size);
    height: var(--review-card-star-size);
  }

  .review-card--{{ block.id }} .review-card__star svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .review-card--{{ block.id }} .review-card__author-name--inline {
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }

  .review-card__title {
    margin: 0;
    font-size: var(--review-card-title-size);
    letter-spacing: 0.02em;
    line-height: 1.25;
  }

  .review-card__body {
    font-size: var(--review-card-body-size);
    line-height: 1.5;
    margin: 0;
  }

  .review-card__author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .review-card__author--bottom,
  .review-card__author--inline {
    margin-top: 0.25rem;
  }

  .review-card__author--top {
    margin-top: -0.25rem;
  }

  .review-card__avatar {
    width: var(--review-card-avatar-size);
    height: var(--review-card-avatar-size);
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: rgba(0,0,0,0.06);
  }

  .review-card__avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review-card__avatar--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .review-card__avatar--placeholder svg {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }

  .review-card__author-info {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .review-card__author-name {
    font-size: var(--review-card-body-size);
    font-weight: 500;
  }

  .review-card--{{ block.id }} .review-card__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: calc(var(--review-card-body-size) * 0.9);
    color: var(--review-card-verified-color);
    opacity: 1;
  }

  .review-card--{{ block.id }} .review-card__verified-icon {
    display: inline-flex;
    color: var(--review-card-verified-color);
  }
</style>

{% schema %}
{
  "name": "Review card",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Bewertung"
    },
    {
      "type": "range",
      "id": "star_rating",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "label": "Sterne",
      "default": 5
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Sternengröße",
      "default": 20
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Sternenfarbe",
      "default": "#D4AF37"
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Überschrift der Bewertung",
      "default": "GREAT FLAVOR!"
    },
    {
      "type": "inline_richtext",
      "id": "body",
      "label": "Bewertungstext",
      "default": "I used to grab a second coffee to get through the day, but it left me jittery with liquid i.v., I feel refreshed, focused, and hydrated without the crash it's a must-have in my daily routine now."
    },
    {
      "type": "header",
      "content": "Verfasser"
    },
    {
      "type": "select",
      "id": "author_position",
      "label": "Position",
      "options": [
        { "value": "bottom", "label": "Unten in der Karte" },
        { "value": "top", "label": "Direkt unter den Sternen" },
        { "value": "inline", "label": "Name neben den Sternen" }
      ],
      "default": "bottom",
      "info": "Bei ‚Name neben den Sternen‘ bleiben Profilbild und Siegel unten in der Karte."
    },
    {
      "type": "range",
      "id": "name_gap",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Abstand zwischen Sternen und Name",
      "default": 10,
      "visible_if": "{{ block.settings.author_position == 'inline' }}"
    },
    {
      "type": "checkbox",
      "id": "show_avatar",
      "label": "Profilbild anzeigen",
      "default": true,
      "info": "Aus = weder Foto noch graue Platzhalter-Silhouette."
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "Profilbild",
      "visible_if": "{{ block.settings.show_avatar }}"
    },
    {
      "type": "range",
      "id": "avatar_size",
      "min": 32,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Größe des Profilbilds",
      "default": 40,
      "visible_if": "{{ block.settings.show_avatar }}"
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Name",
      "default": "Isaac M."
    },
    {
      "type": "checkbox",
      "id": "show_verified",
      "label": "Verifiziert-Siegel anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "verified_text",
      "label": "Text am Siegel",
      "default": "Verified Customer",
      "visible_if": "{{ block.settings.show_verified }}"
    },
    {
      "type": "color",
      "id": "verified_color",
      "label": "Farbe des Siegels",
      "default": "#5E887E",
      "info": "Gilt für Häkchen und Text.",
      "visible_if": "{{ block.settings.show_verified }}"
    },
    {
      "type": "header",
      "content": "Schrift"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Größe der Überschrift",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Größe des Fließtexts",
      "default": 15
    },
    {
      "type": "header",
      "content": "Gestaltung"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "default": "#F8F7F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Eckenrundung",
      "default": 8
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Rahmendicke",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Rahmenfarbe",
      "default": "#e0ddd6"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Abstand oben",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Abstand unten",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Abstand links & rechts",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Review card",
      "category": "Custom"
    }
  ]
}
{% endschema %}

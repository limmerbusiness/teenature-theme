{%- liquid
  assign product = product | default: closest.product
  assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id
-%}
{% render 'tiered-quantity-selector-simple', product: product, block: block, section: section, product_form_id: product_form_id %}

{% schema %}
{
  "name": "Quantity Breaks — Simple",
  "settings": [
    {
      "type": "header",
      "content": "Quantity Breaks — Simple"
    },
    {
      "type": "paragraph",
      "content": "IMPORTANT: Please note that in order for the discounts to work, you'll need to set automatic discounts in your Shopify admin. Learn more about automatic discounts [here](https://help.shopify.com/en/manual/discounts/discount-types)."
    },
    {
      "type": "paragraph",
      "content": "[Use this tutorial to setup](https://help.lumintheme.com/lumin-theme-documentation/product-page/quantity-breaks-discount)"
    },
    {
      "type": "header",
      "content": "Product and Collection Selection"
    },
    {
      "type": "checkbox",
      "id": "show_on_all_products",
      "label": "Show On All Products",
      "default": true
    },
    {
      "type": "product_list",
      "id": "selected_product",
      "label": "Select Product",
      "info": "Choose a specific product for which this block should be displayed."
    },
    {
      "type": "collection",
      "id": "selected_collection",
      "label": "Select Collection",
      "info": "Choose a collection for which this block should be displayed on all its products."
    },
    {
      "type": "select",
      "id": "quantity_style",
      "options": [
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "horizontal-nogap",
          "label": "Horizontal No Gap"
        }
      ],
      "default": "vertical",
      "label": "Selector Style"
    },
    {
      "type": "select",
      "id": "columns_block",
      "options": [
        {
          "value": "40",
          "label": "2"
        },
        {
          "value": "25",
          "label": "3"
        },
        {
          "value": "20",
          "label": "4"
        },
        {
          "value": "none",
          "label": "Auto"
        }
      ],
      "default": "25",
      "label": "Columns in first row, other rows will auto adjust.",
      "info": "Work on Vertical selector Style"
    },
    {
      "type": "select",
      "id": "vertical_two_column_layout",
      "label": "2-column card layout",
      "options": [
        {
          "value": "default",
          "label": "Standard"
        },
        {
          "value": "compact",
          "label": "Compact cards"
        }
      ],
      "default": "default",
      "info": "Compact cards show a radio, pack title, and per-unit price in a 2-column grid.",
      "visible_if": "{{ block.settings.quantity_style == 'vertical' and block.settings.columns_block == '40' }}"
    },
    {
      "type": "select",
      "id": "option_height",
      "options": [
        {
          "value": "auto",
          "label": "Equal"
        },
        {
          "value": "fit-content",
          "label": "Auto"
        }
      ],
      "default": "auto",
      "label": "Option Height",
      "info": "Work on Vertical selector Style"
    },
    {
      "type": "select",
      "id": "preselected",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "1",
          "label": "Option #1"
        },
        {
          "value": "2",
          "label": "Option #2"
        },
        {
          "value": "3",
          "label": "Option #3"
        },
        {
          "value": "4",
          "label": "Option #4"
        },
        {
          "value": "5",
          "label": "Option #5"
        },
        {
          "value": "6",
          "label": "Option #6"
        }
      ],
      "default": "2",
      "label": "Preselected option"
    },
    {
      "type": "paragraph",
      "content": "\u26a0\ufe0f Save setting to take effect"
    },
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "select",
      "id": "discount_type",
      "label": "Discount Type",
      "options": [
        {
          "value": "price",
          "label": "Price"
        },
        {
          "value": "percentage",
          "label": "Percentage"
        }
      ],
      "default": "percentage"
    },
    {
      "type": "select",
      "id": "show_strikethrough_price",
      "label": "Strikethrough Pricing Style",
      "options": [
        {
          "value": "calculated",
          "label": "Calculated"
        },
        {
          "value": "original",
          "label": "Original"
        }
      ],
      "default": "calculated"
    },
    {
      "type": "checkbox",
      "id": "hide_checkbox",
      "label": "Hide Dot",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_strikethrough",
      "label": "Show Strikethrough Pricing",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_total_pricing",
      "label": "Show Total Pricing",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_per_unit",
      "label": "Show Per Unit Pricing",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "override_product_price",
      "label": "t:sections.quantity_breaks.override_product_price",
      "default": true,
      "info": "t:sections.quantity_breaks.override_product_price_info"
    },
    {
      "type": "checkbox",
      "id": "compact_per_unit_under_label",
      "label": "Show per unit under label on compact cards",
      "default": false,
      "visible_if": "{{ block.settings.quantity_style == 'vertical' and block.settings.columns_block == '40' and block.settings.vertical_two_column_layout == 'compact' and block.settings.show_per_unit }}"
    },
    {
      "type": "header",
      "content": "Badge Settings"
    },
    {
      "type": "select",
      "id": "badge_style",
      "label": "Badge Style",

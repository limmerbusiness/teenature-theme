          "value": "ribbon ribbon-top-right",
          "label": "Ribbon top Right"
        },
        {
          "value": "ribbon ribbon-bottom-left",
          "label": "Ribbon Bottom Left"
        },
        {
          "value": "ribbon ribbon-long",
          "label": "Ribbon Top Long"
        },
        {
          "value": "ribbon ribbon-top-short",
          "label": "Ribbon Top Short"
        }
      ],
      "default": "tiered-option__badge"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Badge Font Size",
      "default": 1.3,
      "min": 0.5,
      "max": 2,
      "step": 0.1,
      "unit": "rem"
    },
    {
      "type": "range",
      "id": "badge_font_size_mobile",

            "dislike_size": 0,
            "feature_font_size": 16
          },
          "blocks": {}
        },
        "review_CW8fFK": {
          "type": "review",
          "settings": {
            "selected_product": "",
            "star_rating": 5,
            "show_verified_buyer": true,
            "name_text": "Sophia Nguyen – Toronto, Canada",
            "country_code": "CA",
            "show_country_flag": true,
            "date_text": "Jan 2026",
            "review_head": "Improved Recovery and Better Sleep",
            "review_text": "As someone who trains four to five times a week, recovery has always been a challenge for me. Since starting this supplement, I’ve noticed significantly less soreness and a deeper, more restful sleep at night. I wake up feeling refreshed instead of groggy, which has been a huge improvement. I appreciate that the ingredients are clean and clearly listed without unnecessary fillers. Highly recommended for anyone who wants to support their fitness goals naturally.",
            "like_size": 17,
            "dislike_size": 0,
            "feature_font_size": 16
          },
          "blocks": {}
        },
        "review_XTzRCE": {
          "type": "review",
          "settings": {
            "selected_product": "",
            "star_rating": 5,
            "show_verified_buyer": true,
            "name_text": "Isabella Santos – Madrid, Spain",
            "country_code": "ES",
            "show_country_flag": true,
            "date_text": "March 2026",
            "review_head": "Great for Digestion and Gut Health",
            "review_text": "I bought this after struggling with bloating and slow digestion for months. Within the first week, I felt lighter and more regular, and my stomach discomfort almost completely disappeared. I’ve tried many gut-health products before, but this is the only one that actually gave me noticeable results. The capsules are easy to take and don’t have any weird aftertaste. It’s a bit pricier than other brands, but honestly, it’s worth every euro for how much better I feel.",
            "like_size": 0,
            "dislike_size": 0,
            "feature_font_size": 16
          },
          "blocks": {}
        },
        "review_PUweDh": {

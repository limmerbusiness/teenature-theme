                "tab_3_show_description": false,
                "tab_3_description_order": "1",
                "tab_3_image_order": "2",
                "tab_3_page": "",
                "tab_3_page_order": "3",
                "tab_3_richtext": "<p><strong>Shipping Details</strong><br/><br/>We process all orders quickly and ship within 1–2 business days. Delivery times typically range from 3–7 business days depending on your location. Once your order has been shipped, you will receive a tracking number so you can follow your package every step of the way.</p>",

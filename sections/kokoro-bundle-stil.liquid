{%- comment -%}
  Unsichtbarer Abschnitt mit Einstellungen fuer die Bundle Deals.

  Warum eigener Abschnitt: sections/bundle-deals.liquid ist 63 KB gross und
  enthaelt die Rabatt- und Warenkorblogik. Fuer ein paar Regler wuerde die ganze
  Datei neu geschrieben - ein Tippfehler dort legt den Verkauf lahm. Deshalb
  stehen die Regler hier, und es wird nur CSS plus ein unsichtbares Element mit
  data-Attributen ausgegeben, das assets/kokoro-bundle-shipping.js ausliest.

  Einmal pro Seite einfuegen, an beliebiger Stelle. Im Shop unsichtbar.
  Alle Groessen: 0 bedeutet "wie im Theme" - dann wird nichts ausgegeben.
{%- endcomment -%}

{%- assign s = section.settings -%}

{%- style -%}
  {%- if s.hide_instruction -%}
    .bundle-deals__summary-instruction { display: none; }
  {%- endif -%}

  {%- if s.hide_progress or s.shipping_bar -%}
    .bundle-deals__progress,
    .bundle-deals__flat-progress,
    .bundle-deals__tier-progress { display: none; }
  {%- endif -%}

  {%- if s.hide_disclaimer -%}
    .bundle-deals__disclaimer { display: none; }
  {%- endif -%}

  {%- if s.price_position == 'right' -%}
    .bundle-deals__checkout-button .add-to-cart-text { flex-direction: row-reverse; }
  {%- else -%}
    .bundle-deals__checkout-button .add-to-cart-text { flex-direction: row; }
  {%- endif -%}

  /* Versand-Fortschritt */
  .kokoro-shipping {
    margin-block: 8px 16px;
  }

  .kokoro-shipping__text {
    margin: 0 0 8px;
    font-size: {{ s.shipping_text_size | default: 15 }}px;
    font-weight: 500;
    line-height: 1.4;
  }

  .kokoro-shipping__track {
    height: {{ s.shipping_bar_height | default: 8 }}px;
    border-radius: 999px;
    background: {{ s.shipping_track_color | default: '#ECECEC' }};
    overflow: hidden;
  }

  .kokoro-shipping__fill {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    transition: width 0.3s ease;
  }

  @media screen and (min-width: 750px) {
    {%- if s.size_heading > 0 -%}
      .bundle-deals__header, .bundle-deals__header * { font-size: {{ s.size_heading }}px; }
    {%- endif -%}
    {%- if s.size_subtitle > 0 -%}
      .bundle-deals__subtitle, .bundle-deals__subtitle * { font-size: {{ s.size_subtitle }}px; }
    {%- endif -%}
    {%- if s.size_card_title > 0 -%}
      .bundle-product-card__title, .bundle-product-card__title a { font-size: {{ s.size_card_title }}px; }
    {%- endif -%}
    {%- if s.size_card_price > 0 -%}
      .bundle-product-card__price, .bundle-product-card__price * { font-size: {{ s.size_card_price }}px; }
    {%- endif -%}
    {%- if s.size_card_button > 0 -%}
      .bundle-product-card__add-button { font-size: {{ s.size_card_button }}px; }
    {%- endif -%}
    {%- if s.size_summary_heading > 0 -%}
      .bundle-deals__summary-heading { font-size: {{ s.size_summary_heading }}px; }
    {%- endif -%}
    {%- if s.size_summary_text > 0 -%}
      .bundle-deals__summary-instruction, .bundle-deals__summary-instruction * { font-size: {{ s.size_summary_text }}px; }
    {%- endif -%}
    {%- if s.size_total > 0 -%}
      .bundle-deals__total, .bundle-deals__total * { font-size: {{ s.size_total }}px; }
    {%- endif -%}
    {%- if s.size_checkout > 0 -%}
      .bundle-deals__checkout-button, .bundle-deals__checkout-button * { font-size: {{ s.size_checkout }}px; }
    {%- endif -%}
  }

  @media screen and (max-width: 749px) {
    {%- if s.m_size_heading > 0 -%}
      .bundle-deals__header, .bundle-deals__header * { font-size: {{ s.m_size_heading }}px; }
    {%- endif -%}
    {%- if s.m_size_subtitle > 0 -%}
      .bundle-deals__subtitle, .bundle-deals__subtitle * { font-size: {{ s.m_size_subtitle }}px; }
    {%- endif -%}
    {%- if s.m_size_card_title > 0 -%}
      .bundle-product-card__title, .bundle-product-card__title a { font-size: {{ s.m_size_card_title }}px; }
    {%- endif -%}
    {%- if s.m_size_card_price > 0 -%}
      .bundle-product-card__price, .bundle-product-card__price * { font-size: {{ s.m_size_card_price }}px; }
    {%- endif -%}
    {%- if s.m_size_card_button > 0 -%}
      .bundle-product-card__add-button { font-size: {{ s.m_size_card_button }}px; }
    {%- endif -%}
    {%- if s.m_size_summary_heading > 0 -%}
      .bundle-deals__summary-heading { font-size: {{ s.m_size_summary_heading }}px; }
    {%- endif -%}
    {%- if s.m_size_summary_text > 0 -%}
      .bundle-deals__summary-instruction, .bundle-deals__summary-instruction * { font-size: {{ s.m_size_summary_text }}px; }
    {%- endif -%}
    {%- if s.m_size_total > 0 -%}
      .bundle-deals__total, .bundle-deals__total * { font-size: {{ s.m_size_total }}px; }
    {%- endif -%}
    {%- if s.m_size_checkout > 0 -%}
      .bundle-deals__checkout-button, .bundle-deals__checkout-button * { font-size: {{ s.m_size_checkout }}px; }
    {%- endif -%}
  }
{%- endstyle -%}

{%- if s.shipping_bar -%}
  <div
    data-kokoro-shipping-bar="true"
    data-threshold="{{ s.shipping_threshold }}"
    data-text-open="{{ s.shipping_text_open | escape }}"
    data-text-done="{{ s.shipping_text_done | escape }}"
    data-color="{{ s.shipping_color }}"
    data-color-done="{{ s.shipping_color_done }}"
    hidden
  ></div>
  <script src="{{ 'kokoro-bundle-shipping.js' | asset_url }}" defer></script>
{%- endif -%}

{% if request.design_mode %}
  <div {{ section.shopify_attributes }} style="display:none"></div>
{% endif %}

{% schema %}

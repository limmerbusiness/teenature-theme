{{ 'lumin-review.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign review_load = section.settings.review_load | default: 6
  assign pagination_style = section.settings.pagination_style | default: 'load_more'
  assign total_reviews = 0
  assign show_all_reviews = false

  if request.design_mode and section.settings.editing
    assign show_all_reviews = true
  endif

  # Theme blocks report block.type as "@theme", and settings are empty when
  # iterating section.blocks from the section. Identify reviews via block id.
  for block in section.blocks
    if block.type == 'review' or block.type == '_lumin-review' or block.id contains 'review_'
      assign total_reviews = total_reviews | plus: 1
    endif
  endfor
-%}

{%- capture lr_review_block_order_json -%}
[
{%- assign lr_review_order_first = true -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'review' or block.type == '_lumin-review' or block.id contains 'review_' -%}
    {%- assign lr_block_key = block.id -%}
    {%- unless block.id contains section.id -%}
      {%- assign lr_block_key = section.id | append: '__' | append: block.id -%}
    {%- endunless -%}
    {%- unless lr_review_order_first -%},{%- endunless -%}
    {{- lr_block_key | json -}}
    {%- assign lr_review_order_first = false -%}
  {%- endif -%}
{%- endfor -%}
]
{%- endcapture -%}

{%- capture lr_review_order_map_json -%}
{
{%- assign lr_review_map_first = true -%}
{%- assign lr_review_map_index = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'review' or block.type == '_lumin-review' or block.id contains 'review_' -%}
    {%- assign lr_review_map_index = lr_review_map_index | plus: 1 -%}
    {%- assign lr_block_key = block.id -%}
    {%- unless block.id contains section.id -%}
      {%- assign lr_block_key = section.id | append: '__' | append: block.id -%}
    {%- endunless -%}
    {%- unless lr_review_map_first -%},{%- endunless -%}
    {{- lr_block_key | json -}}:{{- lr_review_map_index -}}
    {%- assign lr_review_map_first = false -%}
  {%- endif -%}
{%- endfor -%}
}
{%- endcapture -%}

{%- liquid
  assign total_pages = total_reviews | plus: review_load | minus: 1 | divided_by: review_load

  assign visible_reviews = total_reviews
  unless show_all_reviews
    if total_reviews > review_load
      assign visible_reviews = review_load
    endif
  endunless

  assign lr_columns_desk = section.settings.review_column_desk
  assign lr_columns_tab = section.settings.review_column_tab
  assign lr_columns_mobile = section.settings.review_column_mobile

  if visible_reviews > 0 and visible_reviews < lr_columns_desk
    assign lr_columns_desk = visible_reviews
  endif
  if visible_reviews > 0 and visible_reviews < lr_columns_tab
    assign lr_columns_tab = visible_reviews
  endif
  if visible_reviews > 0 and visible_reviews < lr_columns_mobile
    assign lr_columns_mobile = visible_reviews
  endif

  assign lr_has_multi_column = false
  if section.settings.review_column_mobile > 1 or section.settings.review_column_tab > 1 or section.settings.review_column_desk > 1
    assign lr_has_multi_column = true
  endif

  assign lr_desk_image_card = false
  if section.settings.review_column_desk > 1 and section.settings.review_desk_image_card
    assign lr_desk_image_card = true
  endif

  assign lr_show_load_preview = false
  if pagination_style == 'load_more' and lr_has_multi_column and section.settings.show_load_more_fade
    assign lr_show_load_preview = true
  endif

  assign lr_star_scale = section.settings.star_size | default: 0.7
  assign lr_star_scale_top = section.settings.star_size_top | default: 1

  capture lr_css_vars
    echo '--padding-block-start: ' | append: section.settings.padding_top | append: 'px;'
    echo '--padding-block-end: ' | append: section.settings.padding_bottom | append: 'px;'
    echo '--lr-feature-color: ' | append: section.settings.feature_svg_color | append: ';'
    echo '--lr-inactive-star-color: ' | append: section.settings.inactive_star_color | append: ';'
    echo '--lr-star-scale-top: ' | append: lr_star_scale_top | append: ';'
    echo '--lr-star-scale: ' | append: lr_star_scale | append: ';'
    echo '--lr-border-radius: ' | append: section.settings.border_radius | append: 'px;'
    echo '--lr-rw-border: ' | append: section.settings.rw_border | append: ';'
    echo '--lr-columns-mobile: ' | append: lr_columns_mobile | append: ';'
    echo '--lr-columns-tab: ' | append: lr_columns_tab | append: ';'
    echo '--lr-columns-desk: ' | append: lr_columns_desk | append: ';'
    echo '--lr-columns-active: ' | append: lr_columns_desk | append: ';'
    echo '--lr-review-pd: ' | append: section.settings.review_pd | append: 'px;'
    echo '--lr-review-pd-m: ' | append: section.settings.review_pd_m | append: 'px;'
    echo '--lr-review-bg: ' | append: section.settings.review_bg | append: ';'
    echo '--lr-rw-margin: ' | append: section.settings.rw_margin | append: 'px;'
    echo '--lr-verify-color: ' | append: section.settings.section_bg3 | append: ';'
    echo '--lr-verify-badge-fill: ' | append: section.settings.section_bg2 | append: ';'
    echo '--lr-date-size: ' | append: section.settings.date_size | append: 'px;'
    echo '--lr-block-name-size: ' | append: section.settings.block_name_size | append: 'px;'
    echo '--lr-block-head-size: ' | append: section.settings.block_head_size | append: 'px;'
    echo '--lr-block-text-size: ' | append: section.settings.block_text_size | append: 'px;'
    echo '--lr-img-size: ' | append: section.settings.rw_img_size | append: 'px;'
    echo '--lr-img-radius: ' | append: section.settings.rw_img_radius | append: 'px;'
    echo '--lr-customer-image-size: ' | append: section.settings.customer_image_size | append: 'px;'
    echo '--lr-customer-image-radius: ' | append: section.settings.customer_image_radius | append: 'px;'
    echo '--lr-customer-initials-bg: ' | append: section.settings.customer_initials_bg | append: ';'
    echo '--lr-customer-initials-color: ' | append: section.settings.customer_initials_color | append: ';'
    echo '--lr-add-review-btn-bg: ' | append: section.settings.add_review_button_bg | append: ';'
    echo '--lr-add-review-btn-text: ' | append: section.settings.add_review_button_text_color | append: ';'
    echo '--lr-popup-customer-size: ' | append: section.settings.popup_customer_image_size | default: 60 | append: 'px;'
    echo '--lr-product-image-radius: ' | append: section.settings.product_image_radius | default: 0 | append: 'px;'
    echo '--lr-title-size: ' | append: section.settings.rw_title_size | append: 'px;'
    echo '--lr-title-align: ' | append: section.settings.rw_title_alignment | append: ';'
    echo '--lr-cta-heading-color: ' | append: section.settings.review_cta_heading_color | append: ';'
    echo '--lr-cta-subtext-color: ' | append: section.settings.review_cta_subtext_color | append: ';'
    echo '--lr-star-radius: ' | append: section.settings.star_radius | append: 'px;'
    echo '--star-color: ' | append: section.settings.inactive_star_color | append: ';'
    echo '--star-background: ' | append: section.settings.feature_svg_color | append: ';'
    echo '--lr-fade-height: ' | append: section.settings.load_more_fade_height | default: 120 | append: 'px;'
  endcapture
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.star_style == 'star_bg' or section.settings.star_style == 'star_bg_2' -%}
  {%- style -%}
    .lumin-review-section[data-section-id="{{ section.id }}"] .rating i {
      border-color: {{ section.settings.inactive_star_color }};
      background: {{ section.settings.inactive_star_color }};
      border-radius: {{ section.settings.star_radius }}px;
    }
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="1"] .star-1,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="2"] .star-1,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="2"] .star-2,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="3"] .star-1,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="3"] .star-2,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="3"] .star-3,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="4"] .star-1,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="4"] .star-2,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="4"] .star-3,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="4"] .star-4,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="5"] .star-1,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="5"] .star-2,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="5"] .star-3,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="5"] .star-4,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating="5"] .star-5 {
      border-color: {{ section.settings.feature_svg_color }};
      background: {{ section.settings.feature_svg_color }};
    }
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="1.5"] .star-2,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="2.5"] .star-3,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="3.5"] .star-4,
    .lumin-review-section[data-section-id="{{ section.id }}"] [data-rating^="4.5"] .star-5 {
      border-left-color: {{ section.settings.feature_svg_color }};
    }
  {%- endstyle -%}
{%- endif -%}

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div class="section-background color-{{ section.settings.color_scheme }}" {% if section.settings.ancher_id != blank %}id="{{ section.settings.ancher_id }}"{% endif %}></div>
{% render 'skip-to-content-link', href: '#lmReview-{{ section.id }}', text: 'accessibility.skip_to_reviews' %}

<div
  id="lmReview-{{ section.id }}"
  class="section section--{{ section.settings.section_width | default: 'page' }} color-{{ section.settings.color_scheme }} lumin-review-section spacing-style gap-style{% if lr_desk_image_card %} lumin-review-section--image-card{% endif %}"
  style="{{ lr_css_vars }}"
  data-lumin-review
  data-section-id="{{ section.id }}"
  data-star-style="{{ section.settings.star_style }}"
  role="region"
  aria-labelledby="reviews-heading-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  {% render 'lumin-review-star-sprite', section: section %}
  <script type="application/json" data-lumin-review-config>
    {
      "reviewLoad": {{ review_load }},
      "totalReviews": {{ total_reviews }},
      "totalPages": {{ total_pages }},
      "paginationStyle": {{ pagination_style | json }},
      "showLoadMoreFade": {{ section.settings.show_load_more_fade | default: true | json }},
      "hasMultiColumn": {{ lr_has_multi_column | json }},
      "maxColumnsDesk": {{ section.settings.review_column_desk }},
      "maxColumnsTab": {{ section.settings.review_column_tab }},
      "maxColumnsMobile": {{ section.settings.review_column_mobile }},
      "minColumnWidth": 140,
      "enablePopup": {{ section.settings.enable_review_popup | json }},
      "showAddReviewButton": {{ section.settings.show_add_review_button | json }},
      "showCountryFlags": {{ section.settings.show_country_flags | json }},
      "showPopupProductInfo": {{ section.settings.show_popup_product_info | json }},
      "showPopupHelpfulButtons": {{ section.settings.show_popup_helpful_buttons | json }},
      "enableImageEnlarge": {{ section.settings.enable_image_enlarge | json }},
      "featureColor": {{ section.settings.feature_svg_color | json }},
      "inactiveColor": {{ section.settings.inactive_star_color | json }},
      "starSpriteId": {{ 'lumin-star-' | append: section.id | json }},
      "starHalfGradientId": {{ 'lumin-star-half-' | append: section.id | json }},
      "popupImageQuality": {{ section.settings.popup_image_quality | default: '800' | json }},
      "popupCustomerImageSize": {{ section.settings.popup_customer_image_size | default: 60 }},
      "successTitle": {{ section.settings.success_message_title | default: 'Thank you for your review!' | json }},
      "successBody": {{ section.settings.success_message_body | default: 'Your review has been submitted successfully.' | json }},
      "successDuration": {{ section.settings.success_message_duration | default: 3 | times: 1000 }},
      "successBg": {{ section.settings.success_message_bg | default: '#4CAF50' | json }},
      "successText": {{ section.settings.success_message_text | default: '#ffffff' | json }},
      "successFontSize": {{ section.settings.success_message_font_size | default: 16 | json }},
      "sectionId": {{ section.id | json }},
      "reviewBlockOrder": {{ lr_review_block_order_json | strip }},
      "reviewOrder": {{ lr_review_order_map_json | strip }}
    }
  </script>

  <div class="page-width">
    <h2 id="reviews-heading-{{ section.id }}" class="rw-title">{{ section.settings.header_text }}</h2>

    {%- if section.settings.show_top -%}
      {%- liquid
        assign top_rating_items = 'center'
        if section.settings.top_rating_alignment == 'left'
          assign top_rating_items = 'flex-start'
        elsif section.settings.top_rating_alignment == 'right'
          assign top_rating_items = 'flex-end'
        endif
      -%}
      <div class="top-review-box">
        <div class="rating-box zoom-top" style="align-items: {{ top_rating_items }};">
          <p class="rw-rating-text" style="margin: 0; font-size: {{ section.settings.rating_text_size }}px; line-height: 1; text-align: {{ section.settings.top_rating_alignment }}; width: 100%;">{{ section.settings.rating_text }}</p>
          {%- if section.settings.star_style == 'star' -%}
            {% render 'review-star', section: section %}
          {%- elsif section.settings.star_style == 'star_bg' -%}
            {% render 'review-star-background', section: section %}
          {%- elsif section.settings.star_style == 'star_bg_2' -%}
            {% render 'review-star-crisp', section: section %}
          {%- endif -%}
          {%- unless section.settings.rating_count == blank -%}
            <p style="margin: 0; text-align: {{ section.settings.top_rating_alignment }}; width: 100%;">{{ section.settings.rating_count }}</p>
          {%- endunless -%}
        </div>
      </div>
      <lr></lr>
    {%- endif -%}

    {% content_for 'block', type: 'rating_summary', id: 'rating_summary' %}
    {% content_for 'block', type: 'thumbnail_gallery', id: 'thumbnail_gallery' %}

    <div class="load-more-container">
      <div class="load-more-stage" data-lumin-review-stage>
        <div class="load-more-list-wrap">
          <script type="application/json" data-lumin-review-block-order>{{ lr_review_block_order_json | strip }}</script>
          <div class="rw-container rw-container--flat" data-lumin-review-list role="list" data-lumin-section-id="{{ section.id }}">
            {% content_for 'blocks' %}
          </div>

          {%- if lr_show_load_preview and total_reviews > review_load and show_all_reviews == false -%}
            <div class="load-more-fade" data-lumin-review-fade aria-hidden="true"></div>
          {%- endif -%}
        </div>
      </div>

      {%- unless show_all_reviews -%}
        <div class="lumin-review-deferred-store" data-lumin-review-deferred hidden></div>
      {%- endunless -%}

      {%- if total_reviews > review_load and show_all_reviews == false -%}
        {%- if pagination_style == 'numbered' -%}
          <nav class="lumin-review-pagination" aria-label="{{ 'content.pagination.nav_label' | t }}" data-lumin-review-pagination>
            <ul class="lumin-review-pagination__list" role="list">
              {%- for page_num in (1..total_pages) -%}
                <li class="lumin-review-pagination__item">
                  <button
                    type="button"
                    class="lumin-review-pagination__btn{% if page_num == 1 %} is-active{% endif %}"
                    data-page="{{ page_num }}"
                    aria-label="{{ 'content.pagination.page' | t: page: page_num }}"
                    {% if page_num == 1 %}aria-current="page"{% endif %}
                  >
                    {{ page_num }}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- else -%}
          <div class="load-more-actions">
            <button type="button" id="loadMore-{{ section.id }}" class="link-review button" data-lumin-review-load-more>
              {{ section.settings.load_text }}
            </button>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>

  {% render 'lumin-review-popup', section: section %}
  {% render 'lumin-review-add-modal', section: section, product: product %}
</div>

<script src="{{ 'lumin-review.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Lumin Review",
   "disabled_on": {
  "groups": ["header", "footer"]
   },
 "settings": [
   {
        "type": "header",
        "content": "t:sections.lumin-review.note"
      },
   {
        "type": "checkbox",
        "id": "editing",
        "label": "t:sections.lumin-review.edit_mode",
        "default": true,
        "info": "t:sections.lumin-review.edit_mode_info"
      },
   {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "background-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
   {
        "type": "header", 
        "content": "t:sections.lumin-review.top_header"
      },
{
        "type": "inline_richtext",
        "id": "header_text",
        "label": "t:names.product_title",
        "default": "t:sections.lumin-review.header_text"
      },
    {
        "type": "range",
        "id": "rw_title_size",
        "min": 14,
        "max": 72,
        "step": 1,
        "unit": "px",
        "label": "t:sections.lumin-review.rw_title_size",
        "default": 32
      },
    {
        "type": "select",
        "id": "rw_title_alignment",
        "label": "t:sections.lumin-review.rw_title_alignment",
        "options": [
          {
            "value": "left",
            "label": "t:options.left"
          },
          {
            "value": "center",
            "label": "t:options.center"
          },
          {
            "value": "right",
            "label": "t:options.right"
          }
        ],
        "default": "center"
      },
   {
        "type": "checkbox",
        "id": "show_top",
        "label": "t:sections.lumin-review.show_header_contents",
        "default": true
      },

   {
        "type": "inline_richtext",
        "id": "rating_text",
        "label": "t:sections.lumin-review.rating_text",
        "default": "4.8",
        "info": "t:sections.lumin-review.rating_text_info"
      },
    {
        "type": "range",
        "id": "rating_text_size",
        "min": 14,
        "max": 72,
        "step": 1,
        "unit": "px",
        "label": "t:sections.lumin-review.rating_text_size",
        "default": 40
      },
    {
        "type": "select",
        "id": "top_rating_alignment",
        "label": "t:sections.lumin-review.top_rating_alignment",
        "options": [
          {
            "value": "left",
            "label": "t:options.left"
          },
          {
            "value": "center",
            "label": "t:options.center"
          },
          {
            "value": "right",
            "label": "t:options.right"
          }
        ],
        "default": "center"
      },
   {
        "type":      "range",
        "id":        "rating_range",
        "min":       1,
        "max":        5,
        "step":       0.5,
        "label":     "t:sections.lumin-review.star_rating",
        "default":   4.5
     },
    {
    "type":      "range",
    "id":        "star_size_top",
    "min":       0.5,
    "max":        2,
    "step":       0.1,
    "label":     "t:sections.lumin-review.star_size",
    "default":   1
    },
    {
        "type": "inline_richtext",
        "id": "rating_count",
        "label": "t:sections.lumin-review.review_count",
        "default": "Based on 16 Reviews",
        "info": "t:sections.lumin-review.review_count_info"
      },
   {
        "type": "header",
        "content": "t:sections.lumin-review.section_settings"
      },

   {
        "type": "checkbox",
        "id": "show_customer_images",
        "label": "t:sections.lumin-review.show_customer_images",
        "default": true
      },
   {
        "type": "checkbox",
        "id": "show_country_flags",
        "label": "t:sections.lumin-review.show_country_flags",
        "default": true
      },
   {
        "type": "checkbox",
        "id": "show_review_heading",
        "label": "t:sections.lumin-review.show_review_heading",
        "default": true
      },
   {
        "type": "select",
        "id": "flag_style",
        "label": "t:sections.lumin-review.flag_style",
        "options": [
          {
            "value": "circle",
            "label": "t:sections.lumin-review.flag_style_circle"
          },
          {
            "value": "wide",
            "label": "t:sections.lumin-review.flag_style_wide"
          },
          {
            "value": "crisp",
            "label": "t:sections.lumin-review.flag_style_crisp"
          }
        ],
        "default": "circle"
      },
   {
        "type": "range",
        "id": "customer_image_size",
        "min": 10,
        "max": 100,
        "step": 5,
        "unit": "px",
        "label": "t:sections.lumin-review.customer_image_size",
        "default": 40
      },
   {
        "type": "range",
        "id": "customer_image_radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "t:sections.lumin-review.customer_image_radius",
        "default": 30
      },
   {
        "type": "color",
        "id": "customer_initials_bg",
        "label": "t:sections.lumin-review.customer_initials_bg",
        "default": "#FFD700"
      },
   {
        "type": "color",
        "id": "customer_initials_color",
        "label": "t:sections.lumin-review.customer_initials_color",
        "default": "#000000"
      },

